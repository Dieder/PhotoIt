@rendermode InteractiveServer
<navlink  @href="(AlbumId is not null ? $"/albums/{AlbumId}" : "/Albums")"
   class="album-back-link">
    <i class="bi bi-arrow-left" aria-hidden="true"></i>
    <span>Back to albums</span>
</navlink>

@code {
    [Parameter] 
    public string? AlbumId { get; set; }
}
