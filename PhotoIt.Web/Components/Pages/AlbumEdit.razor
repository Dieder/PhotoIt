@page "/albums/{Id}/edit"
@rendermode InteractiveServer
@using PhotoIt.Data
@inject AlbumCatalog Catalog
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@using PhotoIt.Web.Components
@using Microsoft.AspNetCore.Authorization;
@attribute [Authorize]
<PageTitle>Edit album</PageTitle>
@if (isLoading)
{
    <div class="d-flex justify-content-center align-items-center py-5" role="status" aria-live="polite">
        <span class="spinner-border text-primary" aria-hidden="true"></span>
        <span class="visually-hidden">Loading album...</span>
    </div>
}
else if (model is null)
{
    <div class="alert alert-warning">Album not found.</div>
    <a href="albums">Back to albums</a>
}
else
{
    <div class="mb-4">
        <a class="text-decoration-none" href="/albums/@Id">&larr; Back to album</a>
        <h1 class="mt-3">Edit album</h1>
    </div>

    <AlbumForm Model="model" SubmitLabel="Save changes" ActionsAtTop="true" />
}

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private AlbumFormModel? model;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var album = await Catalog.GetAsync(Id);
            if (album is null)
            {
                Navigation.NavigateTo("albums");
                return;
            }

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var currentUserId = CurrentUserHelper.GetUserId(authState.User);
            if (currentUserId != album.UserId)
            {
                Navigation.NavigateTo($"albums/{album.Id}");
                return;
            }

            model = new AlbumFormModel
            {
                Id = album.Id,
                CreatedUtc = album.CreatedUtc,
                UpdatedUtc = album.UpdatedUtc,
                Intro = album.Intro,
                Name = album.Name,
                ImageFolderName = album.ImageFolderName,
                FullDescription = album.FullDescription,
                AlbumType = AlbumTypeCatalog.Get(album.AlbumType).Id,
                Metadata = (album.Metadata ?? []).Select(item => new AlbumMetadataValue
                {
                    Id = item.Id,
                    FunctionalName = item.FunctionalName,
                    FieldId = item.FieldId,
                    Value = item.Value
                }).ToList(),
                TravelStartDate = album.TravelStartDate,
                TravelEndDate = album.TravelEndDate,
                ShowRouteOnCover = album.ShowRouteOnCover,
                UseChapterTitles = album.UseChapterTitles,
                DefaultChapterMode = album.DefaultChapterMode,
                Chapters = album.Chapters ?? [],
            };
        }
        finally
        {
            isLoading = false;
        }
    }
}
