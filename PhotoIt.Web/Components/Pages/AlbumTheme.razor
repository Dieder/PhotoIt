@page "/albums/{Id}/theme"
@using PhotoIt.Data
@using System.IO
@inject AlbumCatalog Catalog
@inject NavigationManager NavManager
@using Microsoft.AspNetCore.Hosting
@inject IWebHostEnvironment Environment

<div class="background-picker">
    <div class="toolbar">
        <button type="button"
                class="@TabClass(mode == "color")"
                @onclick='() => mode = "color"'>
            Colors
        </button>

        <button type="button"
                class="@TabClass(mode == "image")"
                @onclick='() => mode = "image"'>
            Images
        </button>
    </div>

    @if (mode == "color")
    {
        <div class="toolbar">
            <button type="button"
                    class="@TabClass(!pastel)"
                    @onclick="() => pastel = false">
                Basic
            </button>

            <button type="button"
                    class="@TabClass(pastel)"
                    @onclick="() => pastel = true">
                Pastel
            </button>
        </div>

        <div class="color-table">
            @foreach (var family in ColorFamilies)
            {
                <div class="color-row">
                    <span class="color-label">@family.Name</span>

                    <div class="shades">
                        @foreach (var shade in GetShades(family))
                        {
                            <button type="button"
                                    class="swatch @(Value.BackroundColor == shade ? "selected" : "")"
                                    style="@($"background-color:{shade}")"
                                    title="@($"{family.Name}: {shade}")"
                                    aria-label="@($"{family.Name}: {shade}")"
                                    aria-pressed="@(Value.BackroundColor == shade)"
                                    @onclick="() => SelectColor(shade)">
                                @if (Value.BackroundColor == shade)
                                {
                                    <span class="selection-mark">✓</span>
                                }
                            </button>
                        }
                    </div>
                </div>
            }
        </div>

        <p class="hint">Light ← shades → Dark</p>
    }
    else
    {
        <div class="toolbar themes">
            @foreach (var theme in Themes)
            {
                <button type="button"
                        class="@TabClass(selectedTheme == theme)"
                        @onclick="() => selectedTheme = theme">
                    @theme
                </button>
            }
        </div>

        @if (Images.Count == 0)
        {
            <p class="empty-message">
                No images found. Add jpg, jpeg, png or webp files to
                wwwroot/Backgrounds/[theme]/.
            </p>
        }
        else
        {
            <div class="image-grid">
                @foreach (var image in FilteredImages)
                {
                    <button type="button"
                            class="image-card @(Value.ImagePath == image.Url ? "selected" : "")"
                            aria-pressed="@(Value.ImagePath == image.Url)"
                            @onclick="() => SelectImage(image.Url)">
                        <img src="@image.Url"
                             alt="@image.Name"
                             loading="lazy" />

                        <span class="image-caption">
                            <strong>@image.Name</strong>
                            <small>@image.Theme</small>
                        </span>
                    </button>
                }
            </div>
        }
    }

    <div class="preview" style="@PreviewStyle">
        <span>Background preview</span>
    </div>
</div>

@code {
    
    public BackGroundFill Value { get; set; } = new();

    [Parameter]
    public string Id { get; set; } = string.Empty;

    private string mode = "color";
    private string selectedTheme = "all";
    private bool pastel;

    private readonly List<ImageOption> Images = new();
    private readonly List<string> Themes = new() { "all" };

    private static readonly HashSet<string> AllowedExtensions =
        new(StringComparer.OrdinalIgnoreCase)
        {
            ".jpg", ".jpeg", ".png", ".webp"
        };

    private sealed record ColorFamily(
        string Name, int R, int G, int B);

    private sealed record ImageOption(
        string Name, string Theme, string Url);

    private static readonly ColorFamily[] ColorFamilies =
    {
        new("Red",    230, 30, 40),
        new("Green",  20, 160, 65),
        new("Blue",   30, 100, 230),
        new("Yellow", 240, 200, 0),
        new("Orange", 245, 120, 15),
        new("Purple", 145, 45, 205),
        new("White",  255, 255, 255),
        new("Black",  0, 0, 0)
    };

    private IEnumerable<ImageOption> FilteredImages =>
        selectedTheme == "all"
            ? Images
            : Images.Where(image => image.Theme == selectedTheme);

    protected override void OnInitialized()
    {
        if (!string.IsNullOrWhiteSpace(Value.ImagePath))
            mode = "image";

        LoadImages();
    }

    private static string TabClass(bool active) =>
        active ? "tab active" : "tab";

    private IEnumerable<string> GetShades(ColorFamily family)
    {
        for (var index = 0; index < 6; index++)
        {
            // White and black use neutral shades.
            if (family.Name == "White")
            {
                var channel = 255 - index * (pastel ? 3 : 10);
                yield return ToHex(channel, channel, channel);
                continue;
            }

            if (family.Name == "Black")
            {
                var channel = pastel
                    ? 245 - index * 15
                    : 175 - index * 35;

                yield return ToHex(channel, channel, channel);
                continue;
            }

            // Positive amount blends with white;
            // negative amount blends with black.
            var amount = pastel
                ? 0.90 - index * 0.09
                : 0.80 - index * 0.23;

            yield return ToHex(
                Blend(family.R, amount),
                Blend(family.G, amount),
                Blend(family.B, amount));
        }
    }

    private static int Blend(int channel, double amount) =>
        (int)Math.Round(amount >= 0
            ? channel + (255 - channel) * amount
            : channel * (1 + amount));

    private static string ToHex(int r, int g, int b) =>
        $"#{r:X2}{g:X2}{b:X2}";

    private async Task SelectColor(string color)
    {
        Value = new BackGroundFill
        {
            BackroundColor = color,
            ImagePath = null
        };

        Catalog.UpdateBackground(Id, Value);
    }

    private async Task SelectImage(string url)
    {
        Value = new BackGroundFill
        {
            BackroundColor = null,
            ImagePath = url
        };

        await ValueChanged.InvokeAsync(Value);
    }

    private string PreviewStyle =>
        !string.IsNullOrWhiteSpace(Value.ImagePath)
            ? $"background-image:url('{Value.ImagePath}');"
            : $"background-color:{Value.BackroundColor ?? "#f3f4f6"};";

    private void LoadImages()
    {
        var webRoot = Environment.WebRootPath;

        if (string.IsNullOrWhiteSpace(webRoot))
            return;

        var root = Path.Combine(webRoot, "Backgrounds");

        if (!Directory.Exists(root))
            return;

        foreach (var directory in Directory
                     .EnumerateDirectories(root)
                     .OrderBy(path => path))
        {
            var theme = Path.GetFileName(directory);

            if (!Themes.Contains(theme))
                Themes.Add(theme);

            foreach (var file in Directory
                         .EnumerateFiles(directory)
                         .OrderBy(path => path))
            {
                if (!AllowedExtensions.Contains(Path.GetExtension(file)))
                    continue;

                // Browser URLs use forward slashes, not filesystem paths.
                // No leading slash: also supports apps hosted under a base path.
                var url = $"Backgrounds/{Uri.EscapeDataString(theme)}/" +
                          Uri.EscapeDataString(Path.GetFileName(file));

                Images.Add(new ImageOption(
                    Path.GetFileNameWithoutExtension(file),
                    theme,
                    url));
            }
        }
    }
}
