@using PhotoIt.Data
@using System.ComponentModel.DataAnnotations
@using EasyMDE.Blazor
@inject AlbumCatalog Catalog

@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider


<div class="album-form-page">

    <div class="album-form-heading">
        <div class="album-form-heading-icon">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <rect x="3" y="4" width="18" height="16" rx="3"
                      stroke="currentColor" stroke-width="1.7" />
                <circle cx="8" cy="9" r="1.5" fill="currentColor" />
                <path d="M5 17l5-5 3 3 2-2 4 4"
                      stroke="currentColor" stroke-width="1.7"
                      stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </div>
        <div>
            <h1>Album details</h1>
            <p>Give your album a name, description and introduction.</p>
        </div>
    </div>

    <EditForm Model="Model" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />

        <div class="album-form-card">

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-danger mx-4 mt-4 mb-0" role="alert">
                    @errorMessage
                </div>
            }

            <section class="album-form-section">
                <div class="album-section-heading">
                    <div>
                        <h2>Basic information</h2>
                        <p>Identify your collection and describe its contents.</p>
                    </div>
                    <span class="album-section-number">01</span>
                </div>

                <div class="mb-4">
                    <label class="form-label" for="album-name">
                        Album name <span class="text-danger">*</span>
                    </label>
                    <InputText id="album-name"
                               class="form-control album-input"
                               placeholder="e.g. Summer holiday 2026"
                               @bind-Value="Model.Name" />
                    <ValidationMessage For="@(() => Model.Name)" />
                </div>

                <div class="mb-0">
                    <label class="form-label" for="description">
                        Full description
                    </label>
                    <InputTextArea id="description"
                                   class="form-control album-input album-description-input"
                                   placeholder="Describe this album, the occasion or the memories it contains..."
                                   rows="4"
                                   @bind-Value="Model.FullDescription" />
                    <div class="form-text">
                        A description to help visitors understand this collection.
                    </div>
                    <ValidationMessage For="@(() => Model.FullDescription)" />
                </div>
            </section>

            <div class="album-section-divider"></div>

            <section class="album-form-section">
                <div class="album-section-heading">
                    <div>
                        <h2>Introduction</h2>
                        <p>Create a rich introduction using Markdown formatting.</p>
                    </div>
                    <span class="album-section-number">02</span>
                </div>

                <div class="album-editor-label">
                    <label class="form-label mb-0" for="album-intro">
                        Album introduction
                    </label>
                    <span class="album-editor-hint">
                        Markdown supported
                    </span>
                </div>

                <div class="album-markdown-editor">
                    <EasyMdeEditor @bind-Value="Model.Intro" />
    
                </div>

                <ValidationMessage For="@(() => Model.Intro)" />

                <div class="album-editor-help">
                    <span aria-hidden="true">ⓘ</span>
                    Use headings, bold text, links and lists to tell the story
                    behind your photos.
                </div>
            </section>

            <footer class="album-form-footer">
                <a class="btn btn-light album-cancel-button"
                   href="@(ActionsAtTop ? $"/albums/{Model.Id}" : "/albums")">
                    Cancel
                </a>

                <button class="btn btn-primary album-submit-button"
                        type="submit">
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M5 12.5l4.5 4.5L19 7"
                              stroke="currentColor" stroke-width="2"
                              stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    @SubmitLabel
                </button>
            </footer>

        </div>
    </EditForm>
</div>

@code {
    [Parameter, EditorRequired]
    public AlbumFormModel Model { get; set; } = new();

    [Parameter]
    public string SubmitLabel { get; set; } = "Save album";

    [Parameter]
    public bool IsNew { get; set; }

    [Parameter]
    public bool ActionsAtTop { get; set; }

    private string? errorMessage;
    private AuthenticationState authenticationState;

     private readonly EasyMdeOptions Options = new()
    {
        Placeholder = "Write markdown...",
        MinHeight = "300px",

        Toolbar = EasyMdeToolbar.Custom(new ToolbarItem[]
        {
            ToolbarItem.BuiltIn(ToolbarButton.Bold),
            ToolbarItem.BuiltIn(ToolbarButton.Italic),
            ToolbarItem.Separator,
            ToolbarItem.BuiltIn(ToolbarButton.Preview),
            ToolbarItem.BuiltIn(ToolbarButton.Fullscreen),
        }),

        Status = EasyMdeStatus.Custom(new StatusItem[]
        {
            StatusItem.BuiltIn(StatusElement.Lines),
            StatusItem.BuiltIn(StatusElement.Words),
            StatusItem.BuiltIn(StatusElement.Cursor),
        }),

    };

    protected override async Task OnInitializedAsync()
    {
        authenticationState = await AuthStateProvider.GetAuthenticationStateAsync();
        await base.OnInitializedAsync();
    }

    private Task SaveAsync()
    {
        if (string.IsNullOrEmpty(Model.UserId))
        {
            var user = authenticationState.User;
            var emailClaim = user.Claims.FirstOrDefault(c => c.Type == "email");
            Model.UserId = emailClaim?.Value ?? user?.Identity?.Name ?? throw new UnauthorizedAccessException("no user found");
        }
        errorMessage = null;
        if (Catalog.ImageFolderNameExists(Model.ImageFolderName, IsNew ? null : Model.Id))
        {
            errorMessage = "That image folder name is already in use.";
            return Task.CompletedTask;
        }

        if (IsNew)
        {
            Catalog.Create(Model);
        }
        else
        {
            var album = Catalog.Get(Model.Id);
            if (album is null)
            {
                errorMessage = "The album could not be found.";
                return Task.CompletedTask;
            }

            album.Name = Model.Name;
            album.FullDescription = Model.FullDescription;
            album.Intro = Model.Intro;
            album.ImageFolderName = Model.ImageFolderName;

            if (!Catalog.Update(album))
            {
                errorMessage = "The album could not be updated.";
                return Task.CompletedTask;
            }
        }

        Navigation.NavigateTo($"/albums/{Model.Id}");
        return Task.CompletedTask;
    }
}
