@using PhotoIt.Data
@using PhotoIt.ServiceDefaults
@using System.ComponentModel.DataAnnotations
@using EasyMDE.Blazor
@inject AlbumCatalog Catalog
@inject ILogger<AlbumForm> Logger

@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider


<div class="album-form-page">

    <div class="album-form-heading">
        <div class="album-form-heading-icon">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <rect x="3" y="4" width="18" height="16" rx="3"
                      stroke="currentColor" stroke-width="1.7" />
                <circle cx="8" cy="9" r="1.5" fill="currentColor" />
                <path d="M5 17l5-5 3 3 2-2 4 4"
                      stroke="currentColor" stroke-width="1.7"
                      stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </div>
        <div>
            <h1>Album details</h1>
            <p>Give your album a name, description and introduction.</p>
        </div>
    </div>

    <EditForm Model="Model" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />

        <div class="album-form-card">

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-danger mx-4 mt-4 mb-0" role="alert">
                    @errorMessage
                </div>
            }

            <section class="album-form-section">
                <div class="album-section-heading">
                    <div>
                        <h2>Basic information</h2>
                        <p>Identify your collection and describe its contents.</p>
                    </div>
                    <span class="album-section-number">01</span>
                </div>

                <div class="mb-4">
                    <label class="form-label" for="album-name">
                        Album name <span class="text-danger">*</span>
                    </label>
                    <InputText id="album-name"
                               class="form-control album-input"
                               placeholder="e.g. Summer holiday 2026"
                               @bind-Value="Model.Name" />
                    <ValidationMessage For="@(() => Model.Name)" />
                </div>

                <div class="mb-0">
                    <label class="form-label" for="description">
                        Full description
                    </label>
                    <InputTextArea id="description"
                                   class="form-control album-input album-description-input"
                                   placeholder="Describe this album, the occasion or the memories it contains..."
                                   rows="4"
                                   @bind-Value="Model.FullDescription" />
                    <div class="form-text">
                        A description to help visitors understand this collection.
                    </div>
                    <ValidationMessage For="@(() => Model.FullDescription)" />
                </div>

                <div class="row g-3 mt-2">
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="album-type">Album type</label>
                        <InputSelect id="album-type" class="form-select album-input" @bind-Value="Model.AlbumType">
                            @foreach (var type in AlbumTypeCatalog.All)
                            {
                                <option value="@type.Id">@type.Icon @type.Name</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-12">
                        <p class="form-text mb-0">@SelectedAlbumType.Description @SelectedAlbumType.PresentationHint</p>
                    </div>
                    @foreach (var field in SelectedAlbumType.AlbumFields)
                    {
                        <div class="col-12 col-md-6" @key="field.Id">
                            <label class="form-label" for="@($"album-metadata-{field.Id}")">@field.Label</label>
                            <input id="@($"album-metadata-{field.Id}")"
                                   class="form-control album-input"
                                   type="@GetInputType(field.ValueType)"
                                   step="@(field.ValueType == AlbumMetadataValueType.Integer ? "1" : null)"
                                   value="@GetMetadataValue(field.Id)"
                                   @onchange="args => SetMetadataValue(field.Id, args.Value?.ToString())" />
                            @if (!string.IsNullOrWhiteSpace(field.Unit))
                            {
                                <div class="form-text">@field.Unit</div>
                            }
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(metadataValidationMessage))
                    {
                        <div class="col-12">
                            <div class="alert alert-danger mb-0" role="alert">@metadataValidationMessage</div>
                        </div>
                    }
                </div>

                @if (Model.AlbumType == "travel")
                {
                    <div class="row g-3 mt-2">
                        <div class="col-12 col-md-6">
                            <label class="form-label" for="travel-start">Start date</label>
                            <InputDate id="travel-start" class="form-control album-input" @bind-Value="Model.TravelStartDate" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label" for="travel-end">End date</label>
                            <InputDate id="travel-end" class="form-control album-input" @bind-Value="Model.TravelEndDate" />
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <InputCheckbox id="show-route" class="form-check-input" @bind-Value="Model.ShowRouteOnCover" />
                                <label class="form-check-label" for="show-route">Show route and distance on the album cover</label>
                            </div>
                        </div>
                    </div>
                }
                <div class="row g-3 mt-2">
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="default-chapter-mode">Default mode for new chapters</label>
                        <InputSelect id="default-chapter-mode" class="form-select album-input" @bind-Value="Model.DefaultChapterMode">
                            <option value="@AlbumChapterMode.ChapterOnly">Chapter only</option>
                            <option value="@AlbumChapterMode.ChapterWithPages">Chapter with pages</option>
                        </InputSelect>
                        <div class="form-text">Changing this default does not change existing chapters or their pages.</div>
                    </div>
                </div>
            </section>

            <div class="album-section-divider"></div>

            <section class="album-form-section">
                <div class="album-section-heading">
                    <div>
                        <h2>Introduction</h2>
                        <p>Create a rich introduction using Markdown formatting.</p>
                    </div>
                    <span class="album-section-number">02</span>
                </div>

                <div class="album-editor-label">
                    <label class="form-label mb-0" for="album-intro">
                        Album introduction
                    </label>
                    <span class="album-editor-hint">
                        Markdown supported
                    </span>
                </div>

                <div class="album-markdown-editor">
                    <EasyMdeEditor @bind-Value="Model.Intro" />
    
                </div>

                <ValidationMessage For="@(() => Model.Intro)" />

                <div class="album-editor-help">
                    <span aria-hidden="true">ⓘ</span>
                    Use headings, bold text, links and lists to tell the story
                    behind your photos.
                </div>
            </section>

            <footer class="album-form-footer">
                <a class="btn btn-light album-cancel-button"
                   href="@(ActionsAtTop ? $"/albums/{Model.Id}" : "/albums")">
                    Cancel
                </a>

                <button class="btn btn-primary album-submit-button"
                        type="submit">
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M5 12.5l4.5 4.5L19 7"
                              stroke="currentColor" stroke-width="2"
                              stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    @SubmitLabel
                </button>
            </footer>

        </div>
    </EditForm>
</div>

@code {
    [Parameter, EditorRequired]
    public AlbumFormModel Model { get; set; } = new();

    [Parameter]
    public string SubmitLabel { get; set; } = "Save album";

    [Parameter]
    public bool IsNew { get; set; }

    [Parameter]
    public bool ActionsAtTop { get; set; }

    private string? errorMessage;
    private string? metadataValidationMessage;
    private AuthenticationState authenticationState;
    private AlbumTypeDefinition SelectedAlbumType => AlbumTypeCatalog.Get(Model.AlbumType);

     private readonly EasyMdeOptions Options = new()
    {
        Placeholder = "Write markdown...",
        MinHeight = "300px",

        Toolbar = EasyMdeToolbar.Custom(new ToolbarItem[]
        {
            ToolbarItem.BuiltIn(ToolbarButton.Bold),
            ToolbarItem.BuiltIn(ToolbarButton.Italic),
            ToolbarItem.Separator,
            ToolbarItem.BuiltIn(ToolbarButton.Preview),
            ToolbarItem.BuiltIn(ToolbarButton.Fullscreen),
        }),

        Status = EasyMdeStatus.Custom(new StatusItem[]
        {
            StatusItem.BuiltIn(StatusElement.Lines),
            StatusItem.BuiltIn(StatusElement.Words),
            StatusItem.BuiltIn(StatusElement.Cursor),
        }),

    };

    protected override async Task OnInitializedAsync()
    {
        authenticationState = await AuthStateProvider.GetAuthenticationStateAsync();
        await base.OnInitializedAsync();
    }

    private async Task SaveAsync()
    {
        Model.AlbumType = SelectedAlbumType.Id;
        metadataValidationMessage = AlbumTypeCatalog.ValidateValues(
            SelectedAlbumType.AlbumFields, Model.Metadata, SelectedAlbumType.Id);
        if (metadataValidationMessage is not null)
            return;

        using var activity = PhotoItTelemetry.ActivitySource.StartActivity("album.save");
        activity?.SetTag("album.operation", IsNew ? "create" : "update");
        if (string.IsNullOrEmpty(Model.UserId))
        {
            var user = authenticationState.User;
            var emailClaim = user.Claims.FirstOrDefault(c => c.Type == "email");
            Model.UserId = emailClaim?.Value ?? user?.Identity?.Name ?? throw new UnauthorizedAccessException("no user found");
        }
        errorMessage = null;
       

        if (IsNew && string.IsNullOrEmpty(Model.ImageFolderName))
        {
            Model.Id = Guid.NewGuid().ToString();
            var usernamefromEmail = Model.UserId.Split('@')[0].ToLowerInvariant();
            Model.ImageFolderName = usernamefromEmail + DateTime.Today.ToString("yyyyMMddHHmmss", System.Globalization.CultureInfo.InvariantCulture);
        }

        if (IsNew && await Catalog.ImageFolderNameExistsAsync(Model.ImageFolderName))
        {
            PhotoItTelemetry.RecordAlbumSave(false);
            Logger.LogWarning("Album save failed because the image folder name is already in use.");
            errorMessage = "That image folder name is already in use.";
            return;
        }

        if (IsNew)
        {
            try
            {
                await Catalog.CreateAsync(Model);
                PhotoItTelemetry.RecordAlbumCreated();
                PhotoItTelemetry.RecordAlbumSave(true);
                Logger.LogInformation("Album created. AlbumId: {AlbumId}", Model.Id);
            }
            catch (Exception exception)
            {
                PhotoItTelemetry.RecordAlbumSave(false);
                activity?.SetStatus(System.Diagnostics.ActivityStatusCode.Error, "Album creation failed");
                Logger.LogError(exception, "Album creation failed.");
                errorMessage = "The album could not be created.";
                return;
            }
        }
        else
        {
            var album = await Catalog.GetAsync(Model.Id);
            if (album is null)
            {
                PhotoItTelemetry.RecordAlbumSave(false);
                Logger.LogWarning("Album save failed because the album was not found. AlbumId: {AlbumId}", Model.Id);
                errorMessage = "The album could not be found.";
                return;
            }

            album.Name = Model.Name;
            album.FullDescription = Model.FullDescription;
            album.AlbumType = Model.AlbumType;
            album.Metadata = Model.Metadata.Select(item => new AlbumMetadataValue
            {
                Id = item.Id,
                FunctionalName = item.FunctionalName,
                FieldId = item.FieldId,
                Value = item.Value
            }).ToList();
            album.Intro = Model.Intro;
            album.ImageFolderName = Model.ImageFolderName;
            album.TravelStartDate = Model.TravelStartDate;
            album.TravelEndDate = Model.TravelEndDate;
            album.ShowRouteOnCover = Model.ShowRouteOnCover;
            album.UseChapterTitles = Model.UseChapterTitles;
            album.DefaultChapterMode = Model.DefaultChapterMode;
            album.Chapters = Model.Chapters;

            try
            {
                if (!await Catalog.UpdateAsync(album))
                {
                    PhotoItTelemetry.RecordAlbumSave(false);
                    Logger.LogWarning("Album update failed. AlbumId: {AlbumId}", Model.Id);
                    errorMessage = "The album could not be updated.";
                    return;
                }

                PhotoItTelemetry.RecordAlbumSave(true);
                Logger.LogInformation("Album updated. AlbumId: {AlbumId}", Model.Id);
            }
            catch (Exception exception)
            {
                PhotoItTelemetry.RecordAlbumSave(false);
                activity?.SetStatus(System.Diagnostics.ActivityStatusCode.Error, "Album update failed");
                Logger.LogError(exception, "Album update failed. AlbumId: {AlbumId}", Model.Id);
                errorMessage = "The album could not be updated.";
                return;
            }
        }

        Navigation.NavigateTo($"/albums/{Model.Id}");
    }

    private string GetMetadataValue(string fieldId) =>
        AlbumTypeCatalog.GetValue(Model.Metadata, SelectedAlbumType.Id, fieldId) ?? string.Empty;

    private void SetMetadataValue(string fieldId, string? value)
    {
        Model.AlbumType = SelectedAlbumType.Id;
        Model.Metadata = AlbumTypeCatalog.SetValue(Model.Metadata, Model.AlbumType, fieldId, value);
    }

    private static string GetInputType(AlbumMetadataValueType valueType) => valueType switch
    {
        AlbumMetadataValueType.Date => "date",
        AlbumMetadataValueType.Integer => "number",
        _ => "text",
    };

}
