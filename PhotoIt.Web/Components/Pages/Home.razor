@page "/"

<PageTitle>Photo It Albums</PageTitle>

<div class="album-dashboard">

    <NavLink href="albums/create" class="dashboard-card create-card">
        <div class="dashboard-icon create-icon">
            <svg viewBox="0 0 64 64" fill="none"
                 xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect x="7" y="14" width="38" height="36" rx="6"
                      fill="currentColor" opacity="0.14"/>
                <rect x="13" y="9" width="38" height="36" rx="6"
                      fill="currentColor" opacity="0.25"/>
                <rect x="19" y="5" width="38" height="36" rx="6"
                      fill="white" stroke="currentColor" stroke-width="2.5"/>
                <circle cx="30" cy="16" r="3.5" fill="currentColor"/>
                <path d="M22 34L31 24L37 30L42 25L53 37H22V34Z"
                      fill="currentColor" opacity="0.65"/>
                <circle cx="48" cy="45" r="12" fill="#0d6efd"/>
                <path d="M48 39V51M42 45H54"
                      stroke="white" stroke-width="2.5"
                      stroke-linecap="round"/>
            </svg>
        </div>

        <div class="dashboard-content">
            <span class="dashboard-eyebrow">GET STARTED</span>
            <h2>Create album</h2>
            <p>Create a new photo album and start organising your memories.</p>
        </div>

        <span class="dashboard-arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
                <path d="M5 12H19M12 5L19 12L12 19"
                      stroke="currentColor" stroke-width="2"
                      stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </span>
    </NavLink>

    <NavLink href="albums" class="dashboard-card view-card">
        <div class="dashboard-icon view-icon">
            <svg viewBox="0 0 64 64" fill="none"
                 xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect x="6" y="10" width="52" height="44" rx="7"
                      fill="currentColor" opacity="0.12"/>
                <rect x="11" y="15" width="42" height="34" rx="4"
                      fill="white" stroke="currentColor" stroke-width="2.5"/>
                <rect x="16" y="20" width="15" height="12" rx="2"
                      fill="currentColor" opacity="0.3"/>
                <path d="M16 29L21 24L25 28L28 25L31 29V32H16V29Z"
                      fill="currentColor"/>
                <rect x="35" y="20" width="12" height="3" rx="1.5"
                      fill="currentColor" opacity="0.65"/>
                <rect x="35" y="26" width="9" height="3" rx="1.5"
                      fill="currentColor" opacity="0.3"/>
                <rect x="16" y="37" width="31" height="3" rx="1.5"
                      fill="currentColor" opacity="0.25"/>
            </svg>
        </div>

        <div class="dashboard-content">
            <span class="dashboard-eyebrow">YOUR COLLECTION</span>
            <h2>View albums</h2>
            <p>Explore your photo albums and revisit your favourite memories.</p>
        </div>

        <span class="dashboard-arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
                <path d="M5 12H19M12 5L19 12L12 19"
                      stroke="currentColor" stroke-width="2"
                      stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </span>
    </NavLink>

</div>
