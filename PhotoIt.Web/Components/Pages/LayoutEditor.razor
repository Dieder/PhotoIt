@page "/albums/{Id}/layout/edit"
@rendermode InteractiveServer
@using PhotoIt.Data
@using PhotoIt.Web.Components.Layout
@inject AlbumCatalog Catalog
@inject NavigationManager Navigation
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@using PhotoIt.Web.Components
@using Microsoft.AspNetCore.Authorization;
@attribute [Authorize]

<PageTitle>Edit layout - @(album?.Name ?? "Album")</PageTitle>

@if (album is null)
{
    <div class="alert alert-warning">Album not found.</div>
    <a href="albums">Back to albums</a>
}
else if (albumLayout is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="layout-editor">
        <div class="layout-editor-header mb-3">
            <a class="text-decoration-none" href="albums/@album.Id">&larr; Back to album</a>
            <div class="d-flex justify-content-between align-items-center mt-2 flex-wrap gap-2">
                <div>
                    <h1 class="h3 mb-0">Edit album layout</h1>
                    <p class="text-muted mb-0">@album.Name</p>
                </div>
                <div class="d-flex gap-2">
                    @if (layoutSaved)
                    {
                        <a class="btn btn-outline-secondary" href="albums/@album.Id/layout/view">View album</a>
                    }
                    <button class="btn btn-primary" type="button" @onclick="SaveAsync" disabled="@isSaving">
                        @(isSaving ? "Saving..." : "Save layout")
                    </button>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(statusMessage))
            {
                <div class="alert alert-success mt-2 mb-0 py-2">@statusMessage</div>
            }
            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-danger mt-2 mb-0 py-2">@errorMessage</div>
            }
        </div>

        <div class="layout-editor-body">
            <aside class="photo-library">
                <h2 class="h6">Photo library</h2>
                @if (photos.Count == 0)
                {
                    <p class="text-muted small">No photos uploaded yet. <a href="albums/@album.Id/photos">Upload photos</a>.</p>
                }
                else
                {
                    @foreach (var group in PhotoGroups)
                    {
                        <div class="photo-library-group mb-3">
                            <div class="photo-library-date">@group.Header</div>
                            <div class="photo-library-grid">
                                @foreach (var photo in group.Photos)
                                {
                                    <div class="photo-library-item draggable"
                                         draggable="true"
                                         @ondragstart="() => HandleLibraryDragStart(photo.Id)">
                                        <img src="albums/@album.Id/photos/@photo.Id/content" alt="@photo.OriginalFileName" />
                                        <span class="photo-library-name" title="@photo.OriginalFileName">@photo.OriginalFileName</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </aside>

            
<main class="page-editor">

    <div class="page-editor-toolbar">
        <div class="page-tabs">
            <button type="button"
                    class="page-tab @(selectedPageNumber == 0 ? "active" : "")"
                    @onclick="() => SelectPage(0)">
                <span class="page-tab-icon">T</span>
                Title page
            </button>

            @foreach (var albumPage in albumLayout.Pages.OrderBy(p => p.Number))
            {
                <button type="button"
                        @key="albumPage.Number"
                        class="page-tab @(selectedPageNumber == albumPage.Number ? "active" : "")"
                        @onclick="() => SelectPage(albumPage.Number)">
                    <span class="page-tab-icon">
                        @albumPage.Number
                    </span>
                    <span>@(albumPage.Appearance?.Title ?? "")</span>
                </button>
            }

            <button type="button"
                    class="page-tab page-tab-add"
                    @onclick="AddPage">
                <span aria-hidden="true">+</span> Add page
            </button>
        </div>
    </div>

    @if (selectedPageNumber == 0)
    {
        <details class="editor-panel" open>
            <summary class="editor-panel-summary">
                <span class="editor-panel-icon">T</span>
                <span class="editor-panel-heading">
                    <strong>Title page content</strong>
                    <small>Album title and subtitle</small>
                </span>
                <span class="editor-panel-chevron"></span>
            </summary>

            <div class="editor-panel-content">
                <div class="mb-3">
                    <label class="form-label" for="layout-title">Title</label>
                    <input id="layout-title"
                           class="form-control"
                           @bind="albumLayout.Title"
                           @bind:event="oninput" />
                </div>

                <div class="mb-0">
                    <label class="form-label" for="layout-subtitle">Subtitle</label>
                    <textarea id="layout-subtitle"
                              class="form-control"
                              rows="3"
                              @bind="albumLayout.Subtitle"
                              @bind:event="oninput"></textarea>
                </div>
            </div>
        </details>

        <div class="layout-preview">
            <LayoutPageRenderer AlbumId="@album.Id"
                                IsTitlePage="true"
                                PageNumber="0"
                                Title="@albumLayout.Title"
                                Subtitle="@albumLayout.Subtitle"
                                CoverPhotoId="@albumLayout.CoverPhotoId"
                                PhotoLookup="@photoLookup"
                                Editable="true"
                                OnPhotoDragStarted="HandleDragStarted"
                                OnPhotoDropped="HandleDropped"
                                OnPhotoRemoved="HandleRemoved"
                                OnZoomChanged="HandleZoomChanged"
                                OnPositionChanged="HandlePositionChanged" />
        </div>
    }
    else if (selectedPage is not null)
    {
        <div class="page-actions">
            <div>
                <h2>Page @selectedPage.Number</h2>
                <p>Choose a design and customise its appearance.</p>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <button type="button"
                        class="btn btn-sm btn-outline-secondary"
                        @onclick="() => MovePage(selectedPage.Number, -1)"
                        disabled="@(selectedPage.Number == 1)"
                        title="Move page up">
                    ↑
                </button>

                <button type="button"
                        class="btn btn-sm btn-outline-secondary"
                        @onclick="() => MovePage(selectedPage.Number, 1)"
                        disabled="@(selectedPage.Number == albumLayout.Pages.Count)"
                        title="Move page down">
                    ↓
                </button>

                <button type="button"
                        class="btn btn-sm btn-outline-danger"
                        @onclick="() => DeletePage(selectedPage.Number)">
                    Delete page
                </button>
            </div>
        </div>

        <details class="editor-panel" open>
            <summary class="editor-panel-summary">
                <span class="editor-panel-icon">▦</span>
                <span class="editor-panel-heading">
                    <strong>Page template</strong>
                    <small>Select a photo layout</small>
                </span>
                <span class="editor-panel-chevron"></span>
            </summary>

            <div class="editor-panel-content template-panel-content">
                @if (layoutTemplates is null)
                {
                    <p class="text-muted mb-0">Loading templates...</p>
                }
                else
                {
                    <LayoutTemplateSelector @key="selectedPage.Number"
                                            Templates="layoutTemplates"
                                            SelectedTemplateId="selectedPage.TemplateId"
                                            PageHasPhotos="@selectedPage.Photos.Any(slot => !string.IsNullOrWhiteSpace(slot.PhotoId))"
                                            SelectedTemplateIdChanged="OnTemplateSelected" />
                }
            </div>
        </details>

        <details class="editor-panel" open>
            <summary class="editor-panel-summary">
                <span class="editor-panel-icon">Aa</span>
                <span class="editor-panel-heading">
                    <strong>Page appearance</strong>
                    <small>Title, typography and background</small>
                </span>
                <span class="editor-panel-chevron"></span>
            </summary>

            <div class="editor-panel-content">
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label" for="page-title">Optional title</label>
                        <input id="page-title"
                               class="form-control"
                               @bind="selectedPage.Appearance.Title"
                               @bind:event="oninput"
                               @bind:after="MarkPageAppearanceChanged" />
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label" for="page-title-font">Font family</label>
                        <select id="page-title-font"
                                class="form-select"
                                @bind="selectedPage.Appearance.FontFamily"
                                @bind:after="MarkPageAppearanceChanged">
                            @foreach (var font in PageAppearance.AvailableFonts)
                            {
                                <option value="@font">@font</option>
                            }
                        </select>
                    </div>

                    <div class="col-6 col-md-3">
                        <label class="form-label" for="page-title-size">Font size</label>
                        <div class="input-group">
                            <input id="page-title-size"
                                   class="form-control"
                                   type="number"
                                   min="12"
                                   max="96"
                                   @bind="selectedPage.Appearance.FontSize"
                                   @bind:after="MarkPageAppearanceChanged" />
                            <span class="input-group-text">px</span>
                        </div>
                    </div>

                    <div class="col-6 col-md-3">
                        <label class="form-label" for="page-title-alignment">Alignment</label>
                        <select id="page-title-alignment"
                                class="form-select"
                                @bind="selectedPage.Appearance.TitleAlignment"
                                @bind:after="MarkPageAppearanceChanged">
                            <option value="@PageTitleAlignment.Left">Left</option>
                            <option value="@PageTitleAlignment.Center">Center</option>
                            <option value="@PageTitleAlignment.Right">Right</option>
                        </select>
                    </div>

                    <div class="col-6 col-md-3">
                        <label class="form-label" for="page-title-color">Text color</label>
                        <div class="color-control">
                            <input id="page-title-color"
                                   type="color"
                                   class="form-control form-control-color"
                                   @bind="selectedPage.Appearance.TextColor"
                                   @bind:after="MarkPageAppearanceChanged" />
                            <span>@selectedPage.Appearance.TextColor</span>
                        </div>
                    </div>

                    <div class="col-6 col-md-3">
                        <label class="form-label" for="page-background-style">Background</label>
                        <select id="page-background-style"
                                class="form-select"
                                @bind="selectedPage.Appearance.BackgroundStyle"
                                @bind:after="MarkPageAppearanceChanged">
                            <option value="@PageBackgroundStyle.Solid">Solid color</option>
                            <option value="@PageBackgroundStyle.Gradient">Gradient</option>
                        </select>
                    </div>

                    <div class="col-6 col-md-3">
                        <label class="form-label" for="page-background-color">
                            @(selectedPage.Appearance.BackgroundStyle == PageBackgroundStyle.Gradient
                                ? "Gradient start"
                                : "Background color")
                        </label>
                        <input id="page-background-color"
                               type="color"
                               class="form-control form-control-color w-100"
                               @bind="selectedPage.Appearance.BackgroundColor"
                               @bind:after="MarkPageAppearanceChanged" />
                    </div>

                    @if (selectedPage.Appearance.BackgroundStyle == PageBackgroundStyle.Gradient)
                    {
                        <div class="col-6 col-md-3">
                            <label class="form-label" for="page-background-end-color">
                                Gradient end
                            </label>
                            <input id="page-background-end-color"
                                   type="color"
                                   class="form-control form-control-color w-100"
                                   @bind="selectedPage.Appearance.GradientEndColor"
                                   @bind:after="MarkPageAppearanceChanged" />
                        </div>
                    }
                </div>
            </div>
        </details>

        <div class="layout-preview">
            <LayoutPageRenderer AlbumId="@album.Id"
                                TemplateId="@selectedPage.TemplateId"
                                PageNumber="@selectedPage.Number"
                                Photos="@selectedPage.Photos"
                                Appearance="@selectedPage.Appearance"
                                PhotoLookup="@photoLookup"
                                Editable="true"
                                OnPhotoDragStarted="HandleDragStarted"
                                OnPhotoDropped="HandleDropped"
                                OnPhotoRemoved="HandleRemoved"
                                OnZoomChanged="HandleZoomChanged"
                                OnPositionChanged="HandlePositionChanged" />
        </div>
    }
</main>

        </div>
    </div>
}

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private Album? album;
    private ViewableAlbumLayout? albumLayout;
    private IReadOnlyList<AlbumPhoto> photos = [];
    private Dictionary<string, AlbumPhoto> photoLookup = new(StringComparer.OrdinalIgnoreCase);
    private int selectedPageNumber;
    private LayoutPage? selectedPage;
    private string? draggedPhotoId;
    private int? draggedFromSlotCol;
    private int? draggedFromSlotRow;
    private bool draggedFromTitlePage;
    private int? draggedFromPageNumber;
    private bool isSaving;
    private bool layoutSaved;
    private string? statusMessage;
    private string? errorMessage;
    private IEnumerable<PhotoDateGroup> PhotoGroups =>
        photos
            .GroupBy(GetPhotoGroupDate)
            .OrderByDescending(group => group.Key)
            .Select(group => new PhotoDateGroup(
                group.Key,
                group.Key.ToString("dddd d MMMM yyyy"),
                group.OrderByDescending(GetPhotoSortDate)
                    .ThenBy(photo => photo.OriginalFileName, StringComparer.OrdinalIgnoreCase)
                    .ToList()));

    private static DateTime GetPhotoGroupDate(AlbumPhoto photo)
    {
        return AlbumCatalog.GetDisplayDate(photo.DateTakenUtc, photo.UploadedUtc).Date;
    }

    private static DateTime GetPhotoSortDate(AlbumPhoto photo)
    {
        return AlbumCatalog.GetDisplayDate(photo.DateTakenUtc, photo.UploadedUtc);
    }

    private sealed record PhotoDateGroup(DateTime Date, string Header, List<AlbumPhoto> Photos);
    private List<PhotoIt.Data.LayoutTemplate>? layoutTemplates;

    private void MarkPageAppearanceChanged()
    {
        layoutSaved = false;
        statusMessage = "Page appearance changed. Save the layout to persist it.";
        errorMessage = null;
    }

    protected override async Task OnInitializedAsync()
    {
        album = Catalog.Get(Id);
        if (album is null)
            return;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var currentUserId = CurrentUserHelper.GetUserId(authState.User);
        if (currentUserId != album.UserId)
        {
            Navigation.NavigateTo($"albums/{album.Id}");
            return;
        }

        photos = Catalog.ListPhotos(Id);
        photoLookup = photos.ToDictionary(photo => photo.Id, StringComparer.OrdinalIgnoreCase);
        albumLayout = Catalog.GetLayout(Id);
        layoutSaved = albumLayout is not null;

        if (albumLayout is null)
        {
            albumLayout = new ViewableAlbumLayout
            {
                AlbumId = Id,
                Title = album.Name,
                Subtitle = album.FullDescription,
            };
        }

        // Load templates from wwwroot/data/layout-templates.json if present
        try
        {
            layoutTemplates = await Http.GetFromJsonAsync<List<PhotoIt.Data.LayoutTemplate>>("/data/layout-templates.json")
                             ?? LayoutTemplates.All.ToList();
        }
        catch
        {
            layoutTemplates = LayoutTemplates.All.ToList();
        }

        SelectPage(0);
    }

    private void SelectPage(int pageNumber)
    {
        selectedPageNumber = pageNumber;
        selectedPage = pageNumber == 0
            ? null
            : albumLayout!.Pages.FirstOrDefault(page => page.Number == pageNumber);
    }

    private void AddPage()
    {
        var nextNumber = albumLayout!.Pages.Count == 0 ? 1 : albumLayout.Pages.Max(page => page.Number) + 1;
        var page = new LayoutPage
        {
            Number = nextNumber,
            TemplateId = LayoutTemplateIds.OneBig,
            Photos = LayoutTemplates.Get(LayoutTemplateIds.OneBig).Slots.ToList(),
        };
        albumLayout.Pages.Add(page);
        SelectPage(nextNumber);
    }

    private void DeletePage(int pageNumber)
    {
        albumLayout!.Pages.RemoveAll(page => page.Number == pageNumber);
        RenumberPages();
        SelectPage(albumLayout.Pages.Count == 0 ? 0 : albumLayout.Pages.Min(page => page.Number));
    }

    private void MovePage(int pageNumber, int direction)
    {
        var pages = albumLayout!.Pages.OrderBy(page => page.Number).ToList();
        var index = pages.FindIndex(page => page.Number == pageNumber);
        var targetIndex = index + direction;
        if (index < 0 || targetIndex < 0 || targetIndex >= pages.Count)
            return;

        (pages[index], pages[targetIndex]) = (pages[targetIndex], pages[index]);
        RenumberPagesFrom(pages);
        SelectPage(selectedPageNumber);
    }

    private void RenumberPages()
    {
        RenumberPagesFrom(albumLayout!.Pages.OrderBy(page => page.Number).ToList());
    }

    private void RenumberPagesFrom(List<LayoutPage> pages)
    {
        for (var i = 0; i < pages.Count; i++)
            pages[i].Number = i + 1;

        albumLayout!.Pages = pages;
    }

    private void OnTemplateSelected(string templateId)
    {
        if (selectedPage is null
            || selectedPage.Photos.Any(slot => !string.IsNullOrWhiteSpace(slot.PhotoId))
            || string.Equals(templateId, selectedPage.TemplateId, StringComparison.OrdinalIgnoreCase))
            return;

        selectedPage.TemplateId = templateId;
        selectedPage.Photos = LayoutTemplates.MigratePhotos(templateId, selectedPage.Photos).ToList();
    }

    private void HandleLibraryDragStart(string photoId)
    {
        draggedPhotoId = photoId;
        draggedFromSlotCol = null;
        draggedFromSlotRow = null;
        draggedFromTitlePage = false;
        draggedFromPageNumber = null;
    }

    private Task HandleDragStarted(LayoutDragStartEventArgs args)
    {
        draggedPhotoId = args.PhotoId;
        draggedFromSlotCol = args.slotCol;
        draggedFromSlotRow = args.slotRow;
        draggedFromTitlePage = args.IsTitlePage;
        draggedFromPageNumber = args.FromPageNumber;
        return Task.CompletedTask;
    }

    private Task HandlePositionChanged(LayoutPositionChangedEventArgs args)
    {
        layoutSaved = false;
        statusMessage = "Photo position changed. Save the layout to persist it.";
        return Task.CompletedTask;
    }

    private Task HandleZoomChanged(LayoutZoomChangedEventArgs args)
    {
        layoutSaved = false;
        statusMessage = "Zoom changed. Save the layout to persist it.";
        return Task.CompletedTask;
    }

    private Task HandleDropped(LayoutDropEventArgs args)
    {
        if (string.IsNullOrWhiteSpace(draggedPhotoId))
            return Task.CompletedTask;

        if (args.IsTitlePage)
        {
            if (draggedFromTitlePage && draggedFromSlotCol == 0 && draggedFromSlotRow == 0)
            {
                ClearDragState();
                return Task.CompletedTask;
            }

            albumLayout!.CoverPhotoId = draggedPhotoId;
            if (draggedFromPageNumber is int pageNumber && pageNumber > 0 &&
                draggedFromSlotCol is int sourceCol && draggedFromSlotRow is int sourceRow)
                ClearSlotOnPage(pageNumber, sourceCol, sourceRow);

            ClearDragState();
            return Task.CompletedTask;
        }

        if (selectedPage is null)
        {
            ClearDragState();
            return Task.CompletedTask;
        }

        var targetSlot = selectedPage.Photos.FirstOrDefault(slot =>
            slot.Col == args.slotCol && slot.Row == args.slotRow);
        if (targetSlot is null)
        {
            ClearDragState();
            return Task.CompletedTask;
        }

        if (photoLookup.TryGetValue(draggedPhotoId, out var draggedPhoto)
            && !PhotoType.IsCompatible(targetSlot.Type.Id, draggedPhoto.PixelWidth, draggedPhoto.PixelHeight))
        {
            errorMessage = $"This photo orientation is not compatible with the {targetSlot.Type.Name.ToLowerInvariant()} slot.";
            ClearDragState();
            return Task.CompletedTask;
        }

        if (draggedFromTitlePage)
        {
            albumLayout!.CoverPhotoId = null;
            targetSlot.PhotoId = draggedPhotoId;
            ResetSlotComposition(targetSlot);
            ClearDragState();
            return Task.CompletedTask;
        }

        if (draggedFromPageNumber is int fromPage && fromPage != selectedPage.Number)
        {
            ClearDragState();
            return Task.CompletedTask;
        }

        if (draggedFromSlotCol is null)
        {
            targetSlot.PhotoId = draggedPhotoId;
            ResetSlotComposition(targetSlot);
        }
        else if (draggedFromSlotCol == args.slotCol && draggedFromSlotRow == args.slotRow)
        {
            ClearDragState();
            return Task.CompletedTask;
        }
        else
        {
            var sourceSlot = selectedPage.Photos.FirstOrDefault(slot =>
                slot.Col == draggedFromSlotCol && slot.Row == draggedFromSlotRow);
            if (sourceSlot is null)
            {
                ClearDragState();
                return Task.CompletedTask;
            }

            if (sourceSlot.PhotoId is not null
                && photoLookup.TryGetValue(sourceSlot.PhotoId, out var sourcePhoto)
                && !PhotoType.IsCompatible(targetSlot.Type.Id, sourcePhoto.PixelWidth, sourcePhoto.PixelHeight))
            {
                errorMessage = $"The source photo orientation is not compatible with the {targetSlot.Type.Name.ToLowerInvariant()} slot.";
                ClearDragState();
                return Task.CompletedTask;
            }

            if (targetSlot.PhotoId is not null
                && photoLookup.TryGetValue(targetSlot.PhotoId, out var targetPhoto)
                && !PhotoType.IsCompatible(sourceSlot.Type.Id, targetPhoto.PixelWidth, targetPhoto.PixelHeight))
            {
                errorMessage = "The photos cannot be swapped because their orientations do not match the slots.";
                ClearDragState();
                return Task.CompletedTask;
            }

            SwapSlotContents(sourceSlot, targetSlot);
        }

        ClearDragState();
        return Task.CompletedTask;
    }

    private Task HandleRemoved(LayoutRemoveEventArgs args)
    {
        if (args.IsTitlePage)
        {
            albumLayout!.CoverPhotoId = null;
            return Task.CompletedTask;
        }

        if (selectedPage is null)
            return Task.CompletedTask;

        ClearSlot(selectedPage, args.slotCol, args.slotRow);
        return Task.CompletedTask;
    }

    private static void ClearSlot(LayoutPage page, int slotCol, int slotRow)
    {
        var slot = page.Photos.FirstOrDefault(item => item.Col == slotCol && item.Row == slotRow);
        if (slot is not null)
            slot.PhotoId = null;
    }

    private static void ResetSlotComposition(PhotoSlot slot)
    {
        slot.OffsetX = 0d;
        slot.OffsetY = 0d;
        slot.PositionX = 50d;
        slot.PositionY = 50d;
        slot.Zoom = 1d;
    }

    private static void SwapSlotContents(PhotoSlot sourceSlot, PhotoSlot targetSlot)
    {
        (sourceSlot.PhotoId, targetSlot.PhotoId) = (targetSlot.PhotoId, sourceSlot.PhotoId);
        (sourceSlot.OffsetX, targetSlot.OffsetX) = (targetSlot.OffsetX, sourceSlot.OffsetX);
        (sourceSlot.OffsetY, targetSlot.OffsetY) = (targetSlot.OffsetY, sourceSlot.OffsetY);
        (sourceSlot.PositionX, targetSlot.PositionX) = (targetSlot.PositionX, sourceSlot.PositionX);
        (sourceSlot.PositionY, targetSlot.PositionY) = (targetSlot.PositionY, sourceSlot.PositionY);
        (sourceSlot.Zoom, targetSlot.Zoom) = (targetSlot.Zoom, sourceSlot.Zoom);
    }

    private void ClearSlotOnPage(int pageNumber, int slotCol, int slotRow)
    {
        var page = albumLayout!.Pages.FirstOrDefault(item => item.Number == pageNumber);
        if (page is not null)
            ClearSlot(page, slotCol, slotRow);
    }

    private void ClearDragState()
    {
        draggedPhotoId = null;
        draggedFromSlotCol = null;
        draggedFromSlotRow = null;
        draggedFromTitlePage = false;
        draggedFromPageNumber = null;
    }

    private Task SaveAsync()
    {
        if (albumLayout is null || album is null)
            return Task.CompletedTask;

        isSaving = true;
        errorMessage = null;
        statusMessage = null;
        try
        {
            Catalog.SaveLayout(albumLayout);
            layoutSaved = true;
            statusMessage = "Layout saved.";
        }
        catch (Exception exception)
        {
            errorMessage = $"Save failed: {exception.Message}";
        }
        finally
        {
            isSaving = false;
        }

        return Task.CompletedTask;
    }
}
