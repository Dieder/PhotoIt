@page "/albums/{Id}/layout/edit"
@rendermode InteractiveServer
@using PhotoIt.Data
@using PhotoIt.ServiceDefaults
@using PhotoIt.Web.Components.Layout
@inject AlbumCatalog Catalog
@inject NavigationManager Navigation
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<LayoutEditor> Logger
@using PhotoIt.Web.Components
@using Microsoft.AspNetCore.Authorization;
@attribute [Authorize]

<PageTitle>Edit layout - @(album?.Name ?? "Album")</PageTitle>

@if (isLoading)
{
    <div class="d-flex justify-content-center align-items-center py-5" role="status" aria-live="polite">
        <span class="spinner-border text-primary" aria-hidden="true"></span>
        <span class="visually-hidden">Loading layout editor...</span>
    </div>
}
else if (album is null)
{
    <div class="alert alert-warning">Album not found.</div>
    <a href="albums">Back to albums</a>
}
else if (albumLayout is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="layout-editor">
        <div class="layout-editor-header mb-3">
            <a class="text-decoration-none" href="albums/@album.Id">&larr; Back to album</a>
            <div class="d-flex justify-content-between align-items-center mt-2 flex-wrap gap-2">
                <div>
                    <h1 class="h3 mb-0">Edit album layout</h1>
                    <p class="text-muted mb-0">@album.Name</p>
                </div>
                <div class="d-flex gap-2">
                    @if (layoutSaved)
                    {
                        <a class="btn btn-outline-secondary" href="albums/@album.Id/layout/view">View album</a>
                    }
                    <button class="btn btn-primary" type="button" @onclick="SaveAsync" disabled="@isSaving">
                        @(isSaving ? "Saving..." : "Save layout")
                    </button>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(statusMessage))
            {
                <div class="alert alert-success mt-2 mb-0 py-2">@statusMessage</div>
            }
            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-danger mt-2 mb-0 py-2">@errorMessage</div>
            }
            @if (LegacyPages.Count > 0)
            {
                <div class="alert alert-warning mt-2 mb-0 py-2">
                    @LegacyPages.Count existing page@(LegacyPages.Count == 1 ? "" : "s") are not assigned to a chapter.
                    They remain unchanged and continue to appear in the album.
                </div>
            }
        </div>

        <div class="layout-editor-body">
            <aside class="photo-library">
                <h2 class="h6">@(editingLegacyPages ? "Album photo library" : selectedChapter is null ? "Select a chapter" : $"Photos in {GetChapterDisplayTitle(selectedChapter)}")</h2>
                @if (PhotoLibraryPhotos.Count == 0)
                {
                    @if (selectedChapter is not null && !editingLegacyPages)
                    {
                        <p class="text-muted small">No photos are assigned to this chapter.</p>
                    }
                    else if (editingLegacyPages)
                    {
                        <p class="text-muted small">No photos uploaded yet. <a href="albums/@album.Id/photos/manage">Upload photos</a>.</p>
                    }
                    else
                    {
                        <p class="text-muted small">Select a chapter to see its photos.</p>
                    }
                }
                else
                {
                    @foreach (var group in PhotoGroups)
                    {
                        <div class="photo-library-group mb-3">
                            <div class="photo-library-date">@group.Header</div>
                            <div class="photo-library-grid">
                                @foreach (var photo in group.Photos)
                                {
                                    var usedInLayout = albumLayout.CoverPhotoId == photo.Id
                                        || albumLayout.Pages.Any(page => page.Photos.Any(slot => slot.PhotoId == photo.Id));

                                    <div class="photo-library-item draggable"
                                         draggable="true"
                                         @ondragstart="() => HandleLibraryDragStart(photo.Id)">
                                        @if (PhotoType.IsVideo(photo))
                                        {
                                            <video src="albums/@album.Id/photos/@photo.Id/content"
                                                   aria-label="@photo.OriginalFileName"
                                                   controls
                                                   muted
                                                   playsinline
                                                   preload="metadata"></video>
                                        }
                                        else
                                        {
                                            <img src="albums/@album.Id/photos/@photo.Id/content" alt="@photo.OriginalFileName" />
                                        }
                                        @if (usedInLayout)
                                        {
                                            <span class="photo-used-check" title="Used in album">
                                                ✓
                                            </span>
                                        }
       
                                        <span class="photo-library-name" title="@photo.OriginalFileName">@photo.OriginalFileName</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </aside>

            
<main class="page-editor">

    <section class="layout-chapter-picker mb-3" aria-labelledby="layout-chapter-heading">
        <div class="layout-chapter-picker-heading">
            <div>
                <h2 id="layout-chapter-heading" class="h5 mb-1">Chapters</h2>
                <p class="text-muted mb-0">Select a chapter to create or edit its pages.</p>
            </div>
            <a class="btn btn-sm btn-outline-secondary" href="/albums/@album.Id/photos/manage">Manage chapters</a>
        </div>

        @if (PageChapters.Count == 0)
        {
            <p class="text-muted mb-0">No chapters yet. Add chapters in Manage Photos first.</p>
        }
        else
        {
            <div class="layout-chapter-picker-grid">
                @foreach (var chapter in PageChapters)
                {
                    var thumbnailId = GetChapterThumbnailId(chapter);
                    <button type="button"
                            class="layout-chapter-card @(selectedChapterId == chapter.Id && !editingLegacyPages ? "active" : "")"
                            aria-pressed="@(selectedChapterId == chapter.Id && !editingLegacyPages)"
                            @onclick="() => SelectChapter(chapter.Id)">
                        @if (!string.IsNullOrWhiteSpace(thumbnailId))
                        {
                            <img class="layout-chapter-card-thumbnail"
                                 src="@($"/albums/{album.Id}/photos/{thumbnailId}/thumbnail")"
                                 alt="" />
                        }
                        else
                        {
                            <span class="layout-chapter-card-thumbnail layout-chapter-card-placeholder" aria-hidden="true">✦</span>
                        }
                        <span class="layout-chapter-card-copy">
                            <strong>@GetChapterDisplayTitle(chapter)</strong>
                            <span>@GetChapterPeriod(chapter)</span>
                            <small>@GetChapterModeLabel(chapter.Mode)</small>
                        </span>
                    </button>
                }
            </div>
        }

        @if (LegacyPages.Count > 0)
        {
            <button type="button"
                    class="btn btn-sm btn-outline-secondary mt-2"
                    @onclick="SelectLegacyPages">
                Edit legacy unassigned pages (@LegacyPages.Count)
            </button>
        }

        @if (selectedChapter is not null && selectedChapter.Mode != AlbumChapterMode.ChapterWithPages)
        {
            <div class="alert alert-info mt-3 mb-0 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span>This chapter currently displays its selected photos directly.</span>
                <button type="button"
                        class="btn btn-sm btn-primary"
                        disabled="@isEnablingChapterPages"
                        @onclick="EnableChapterPagesAsync">
                    @(isEnablingChapterPages ? "Enabling..." : "Use page layouts for this chapter")
                </button>
            </div>
        }
    </section>

    <div class="page-editor-toolbar">
        <div class="page-tabs">
            @foreach (var albumPage in CurrentEditorPages)
            {
                <button type="button"
                        @key="@(selectedChapterId + albumPage.Number)"
                        class="page-tab @(selectedPageNumber == albumPage.Number ? "active" : "")"
                        @onclick="() => SelectPage(albumPage.Number)">
                    <span class="page-tab-icon">
                        @albumPage.Number
                    </span>
                    <span>@(albumPage.Appearance?.Title ?? "")</span>
                </button>
            }

            @if (selectedChapter?.Mode == AlbumChapterMode.ChapterWithPages)
            {
                <button type="button"
                        class="page-tab page-tab-add"
                        @onclick="AddPage">
                    <span aria-hidden="true">+</span> Add page
                </button>
            }
        </div>
    </div>

    @if (selectedChapter is null && !editingLegacyPages)
    {
        <div class="alert alert-info">Select a chapter to view its pages and photos.</div>
    }
    else if (selectedPage is not null)
    {
        <div class="page-actions">
            <div>
                <h2>Page @selectedPage.Number</h2>
                <p>Choose a design and customise its appearance.</p>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <button type="button"
                        class="btn btn-sm btn-outline-secondary"
                        @onclick="() => MovePage(selectedPage.Number, -1)"
                        disabled="@(selectedPage.Number == 1)"
                        title="Move page up">
                    ↑
                </button>

                <button type="button"
                        class="btn btn-sm btn-outline-secondary"
                        @onclick="() => MovePage(selectedPage.Number, 1)"
                        disabled="@(selectedPage.Number == CurrentEditorPages.Count)"
                        title="Move page down">
                    ↓
                </button>

                <button type="button"
                        class="btn btn-sm btn-outline-danger"
                        @onclick="() => DeletePage(selectedPage.Number)">
                    Delete page
                </button>
            </div>
        </div>

        @if (editingLegacyPages)
        {
            <div class="border rounded p-3 mb-3 bg-light">
                <label class="form-label" for="legacy-page-chapter">Assign this page to a chapter</label>
                <div class="d-flex gap-2">
                    <select id="legacy-page-chapter" class="form-select" @bind="migrationTargetChapterId">
                        <option value="">Select a chapter</option>
                        @foreach (var chapter in PageChapters)
                        {
                            <option value="@chapter.Id">@GetChapterDisplayTitle(chapter)</option>
                        }
                    </select>
                    <button type="button" class="btn btn-outline-primary text-nowrap" disabled="@(!CanAssignLegacyPage)" @onclick="AssignLegacyPage">
                        Assign page
                    </button>
                </div>
                @if (MigrationTargetChapter is not null && !CanAssignLegacyPage)
                {
                    <div class="form-text text-danger">Every photo on this page must already be selected for the chosen chapter.</div>
                }
            </div>
        }

        <details class="editor-panel" open>
            <summary class="editor-panel-summary">
                <span class="editor-panel-icon">▦</span>
                <span class="editor-panel-heading">
                    <strong>Page template</strong>
                    <small>Select a photo layout</small>
                </span>
                <span class="editor-panel-chevron"></span>
            </summary>

            <div class="editor-panel-content template-panel-content">
                @if (layoutTemplates is null)
                {
                    <p class="text-muted mb-0">Loading templates...</p>
                }
                else
                {
                    <LayoutTemplateSelector @key="selectedPage.Number"
                                            Templates="layoutTemplates"
                                            SelectedTemplateId="selectedPage.TemplateId"
                                            PageHasPhotos="@selectedPage.Photos.Any(slot => !string.IsNullOrWhiteSpace(slot.PhotoId))"
                                            SelectedTemplateIdChanged="OnTemplateSelected" />
                }
            </div>
        </details>

        <details class="editor-panel" open>
            <summary class="editor-panel-summary">
                <span class="editor-panel-icon">Aa</span>
                <span class="editor-panel-heading">
                    <strong>Page appearance</strong>
                    <small>Title, typography and background</small>
                </span>
                <span class="editor-panel-chevron"></span>
            </summary>

            <div class="editor-panel-content">
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label" for="page-title">Optional title</label>
                        <input id="page-title"
                               class="form-control"
                               @bind="selectedPage.Appearance.Title"
                               @bind:event="oninput"
                               @bind:after="MarkPageAppearanceChanged" />
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label" for="page-title-font">Font family</label>
                        <select id="page-title-font"
                                class="form-select"
                                @bind="selectedPage.Appearance.FontFamily"
                                @bind:after="MarkPageAppearanceChanged">
                            @foreach (var font in PageAppearance.AvailableFonts)
                            {
                                <option value="@font">@font</option>
                            }
                        </select>
                    </div>

                    <div class="col-6 col-md-3">
                        <label class="form-label" for="page-title-size">Font size</label>
                        <div class="input-group">
                            <input id="page-title-size"
                                   class="form-control"
                                   type="number"
                                   min="12"
                                   max="96"
                                   @bind="selectedPage.Appearance.FontSize"
                                   @bind:after="MarkPageAppearanceChanged" />
                            <span class="input-group-text">px</span>
                        </div>
                    </div>

                    <div class="col-6 col-md-3">
                        <label class="form-label" for="page-title-alignment">Alignment</label>
                        <select id="page-title-alignment"
                                class="form-select"
                                @bind="selectedPage.Appearance.TitleAlignment"
                                @bind:after="MarkPageAppearanceChanged">
                            <option value="@PageTitleAlignment.Left">Left</option>
                            <option value="@PageTitleAlignment.Center">Center</option>
                            <option value="@PageTitleAlignment.Right">Right</option>
                        </select>
                    </div>

                    <div class="col-6 col-md-3">
                        <label class="form-label" for="page-title-color">Text color</label>
                        <div class="color-control">
                            <input id="page-title-color"
                                   type="color"
                                   class="form-control form-control-color"
                                   @bind="selectedPage.Appearance.TextColor"
                                   @bind:after="MarkPageAppearanceChanged" />
                            <span>@selectedPage.Appearance.TextColor</span>
                        </div>
                    </div>

                    <div class="col-6 col-md-3">
                        <label class="form-label" for="page-background-style">Background</label>
                        <select id="page-background-style"
                                class="form-select"
                                @bind="selectedPage.Appearance.BackgroundStyle"
                                @bind:after="MarkPageAppearanceChanged">
                            <option value="@PageBackgroundStyle.Solid">Solid color</option>
                            <option value="@PageBackgroundStyle.Gradient">Gradient</option>
                        </select>
                    </div>

                    <div class="col-6 col-md-3">
                        <label class="form-label" for="page-background-color">
                            @(selectedPage.Appearance.BackgroundStyle == PageBackgroundStyle.Gradient
                                ? "Gradient start"
                                : "Background color")
                        </label>
                        <input id="page-background-color"
                               type="color"
                               class="form-control form-control-color w-100"
                               @bind="selectedPage.Appearance.BackgroundColor"
                               @bind:after="MarkPageAppearanceChanged" />
                    </div>

                    @if (selectedPage.Appearance.BackgroundStyle == PageBackgroundStyle.Gradient)
                    {
                        <div class="col-6 col-md-3">
                            <label class="form-label" for="page-background-end-color">
                                Gradient end
                            </label>
                            <input id="page-background-end-color"
                                   type="color"
                                   class="form-control form-control-color w-100"
                                   @bind="selectedPage.Appearance.GradientEndColor"
                                   @bind:after="MarkPageAppearanceChanged" />
                        </div>
                    }
                </div>
            </div>
        </details>

        <div class="layout-preview">
            <LayoutPageRenderer AlbumId="@album.Id"
                                TemplateId="@selectedPage.TemplateId"
                                PageNumber="@selectedPage.Number"
                                Photos="@selectedPage.Photos"
                                Appearance="@selectedPage.Appearance"
                                PhotoLookup="@photoLookup"
                                Editable="true"
                                OnPhotoDragStarted="HandleDragStarted"
                                OnPhotoDropped="HandleDropped"
                                OnPhotoRemoved="HandleRemoved"
                                OnZoomChanged="HandleZoomChanged"
                                OnPositionChanged="HandlePositionChanged" />
        </div>
    }
    else
    {
        <div class="alert alert-info">
            @if (editingLegacyPages)
            {
                <span>Select a legacy page to edit it.</span>
            }
            else
            {
                <span>Select a page or add one to start designing this chapter.</span>
            }
        </div>
    }
</main>

        </div>
    </div>
}

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    [Parameter]
    [SupplyParameterFromQuery(Name = "chapterId")]
    public string? ChapterId { get; set; }

    private Album? album;
    private bool isLoading = true;
    private ViewableAlbumLayout? albumLayout;
    private IReadOnlyList<AlbumPhoto> photos = [];
    private Dictionary<string, AlbumPhoto> photoLookup = new(StringComparer.OrdinalIgnoreCase);
    private string? selectedChapterId;
    private bool editingLegacyPages;
    private string? migrationTargetChapterId;
    private AlbumChapter? selectedChapter => album?.Chapters.FirstOrDefault(chapter => chapter.Id == selectedChapterId);
    private AlbumChapter? MigrationTargetChapter => PageChapters.FirstOrDefault(chapter => chapter.Id == migrationTargetChapterId);
    private IReadOnlyList<AlbumChapter> PageChapters => album?.Chapters
        .OrderBy(chapter => chapter.StartDate)
        .ThenBy(chapter => chapter.Title)
        .ToList() ?? [];
    private IReadOnlyList<LayoutPage> ChapterPages => albumLayout is null || selectedChapterId is null
        ? []
        : albumLayout.Pages
            .Where(page => page.ChapterId == selectedChapterId)
            .OrderBy(page => page.Number)
            .ToList();
    private IReadOnlyList<LayoutPage> LegacyPages => albumLayout?.Pages
        .Where(page => string.IsNullOrWhiteSpace(page.ChapterId))
        .OrderBy(page => page.Number)
        .ToList() ?? [];
    private IReadOnlyList<LayoutPage> CurrentEditorPages => editingLegacyPages ? LegacyPages : ChapterPages;
    private bool CanAssignLegacyPage => editingLegacyPages
        && selectedPage is not null
        && MigrationTargetChapter is not null
        && selectedPage.Photos
            .Select(slot => slot.PhotoId)
            .Where(photoId => !string.IsNullOrWhiteSpace(photoId))
            .All(photoId => MigrationTargetChapter.PhotoIds.Contains(photoId!, StringComparer.OrdinalIgnoreCase));
    private IReadOnlyList<AlbumPhoto> PhotoLibraryPhotos => editingLegacyPages
        ? photos
        : selectedChapter is null
            ? []
            : photos.Where(photo => selectedChapter.PhotoIds.Contains(photo.Id, StringComparer.OrdinalIgnoreCase)).ToList();
    private int selectedPageNumber;
    private LayoutPage? selectedPage;
    private string? draggedPhotoId;
    private int? draggedFromSlotCol;
    private int? draggedFromSlotRow;
    private bool draggedFromTitlePage;
    private int? draggedFromPageNumber;
    private bool isSaving;
    private bool isEnablingChapterPages;
    private bool layoutSaved;
    private string? statusMessage;
    private string? errorMessage;
    private IEnumerable<PhotoDateGroup> PhotoGroups =>
        PhotoLibraryPhotos
            .GroupBy(GetPhotoGroupDate)
            .OrderBy(group => group.Key)
            .Select(group => new PhotoDateGroup(
                group.Key,
                group.Key.ToString("dddd d MMMM yyyy"),
                group.OrderBy(GetPhotoSortDate)
                    .ThenBy(photo => photo.OriginalFileName, StringComparer.OrdinalIgnoreCase)
                    .ToList()));

    private static DateTime GetPhotoGroupDate(AlbumPhoto photo)
    {
        return AlbumCatalog.GetDisplayDate(photo.DateTakenUtc, photo.UploadedUtc).Date;
    }

    private static DateTime GetPhotoSortDate(AlbumPhoto photo)
    {
        return AlbumCatalog.GetDisplayDate(photo.DateTakenUtc, photo.UploadedUtc);
    }

    private sealed record PhotoDateGroup(DateTime Date, string Header, List<AlbumPhoto> Photos);
    private List<PhotoIt.Data.LayoutTemplate>? layoutTemplates;

    private void MarkPageAppearanceChanged()
    {
        layoutSaved = false;
        statusMessage = "Page appearance changed. Save the layout to persist it.";
        errorMessage = null;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            album = await Catalog.GetAsync(Id);
            if (album is null)
                return;

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var currentUserId = CurrentUserHelper.GetUserId(authState.User);
            if (currentUserId != album.UserId)
            {
                Navigation.NavigateTo($"albums/{album.Id}");
                return;
            }

            photos = await Catalog.ListPhotosAsync(Id);
            photoLookup = photos.ToDictionary(photo => photo.Id, StringComparer.OrdinalIgnoreCase);
            album.Chapters ??= [];
            foreach (var chapter in album.Chapters)
                chapter.PhotoIds ??= [];
            selectedChapterId = album.Chapters.FirstOrDefault(chapter => chapter.Id == ChapterId)?.Id
                ?? album.Chapters.FirstOrDefault(chapter => chapter.Mode == AlbumChapterMode.ChapterWithPages)?.Id;
            albumLayout = await Catalog.GetLayoutAsync(Id);
            layoutSaved = albumLayout is not null;

            if (albumLayout is null)
            {
                albumLayout = new ViewableAlbumLayout
                {
                    AlbumId = Id,
                    Title = album.Name,
                    Subtitle = album.FullDescription,
                };
            }

            // Load templates from wwwroot/data/layout-templates.json if present
            try
            {
                layoutTemplates = await Http.GetFromJsonAsync<List<PhotoIt.Data.LayoutTemplate>>("/data/layout-templates.json")
                                 ?? LayoutTemplates.All.ToList();
            }
            catch
            {
                layoutTemplates = LayoutTemplates.All.ToList();
            }

            SelectPage(ChapterPages.FirstOrDefault()?.Number ?? 0);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SelectPage(int pageNumber)
    {
        selectedPageNumber = pageNumber;
        selectedPage = pageNumber == 0
            ? null
            : CurrentEditorPages.FirstOrDefault(page => page.Number == pageNumber);
    }

    private void SelectChapter(string chapterId)
    {
        editingLegacyPages = false;
        migrationTargetChapterId = null;
        selectedChapterId = PageChapters.FirstOrDefault(chapter => chapter.Id == chapterId)?.Id;
        SelectPage(ChapterPages.FirstOrDefault()?.Number ?? 0);
    }

    private void SelectLegacyPages()
    {
        editingLegacyPages = true;
        migrationTargetChapterId = null;
        SelectPage(LegacyPages.FirstOrDefault()?.Number ?? 0);
    }

    private static string GetChapterDisplayTitle(AlbumChapter chapter) =>
        string.IsNullOrWhiteSpace(chapter.Title)
            ? chapter.StartDate?.ToString("d MMM yyyy") ?? "Untitled chapter"
            : chapter.Title;

    private string? GetChapterThumbnailId(AlbumChapter chapter)
    {
        if (chapter.ThumbnailPhotoId is not null
            && photoLookup.TryGetValue(chapter.ThumbnailPhotoId, out var thumbnail)
            && !PhotoType.IsVideo(thumbnail))
            return thumbnail.Id;

        return chapter.PhotoIds
            .Where(photoLookup.ContainsKey)
            .Select(photoId => photoLookup[photoId])
            .FirstOrDefault(photo => !PhotoType.IsVideo(photo))?.Id;
    }

    private string GetChapterPeriod(AlbumChapter chapter)
    {
        var chapterPhotos = chapter.PhotoIds
            .Where(photoLookup.ContainsKey)
            .Select(photoId => AlbumCatalog.GetDisplayDate(photoLookup[photoId]).Date)
            .Order()
            .ToList();
        var start = chapter.StartDate?.Date ?? chapterPhotos.FirstOrDefault();
        if (start == default)
            return "Dates not set";

        var nextChapterStart = album?.Chapters
            .Where(candidate => candidate.Id != chapter.Id
                && candidate.StartDate.HasValue
                && candidate.StartDate.Value.Date > start)
            .Select(candidate => (DateTime?)candidate.StartDate!.Value.Date)
            .OrderBy(date => date)
            .FirstOrDefault();
        var end = chapter.EndDate?.Date
            ?? nextChapterStart?.AddDays(-1)
            ?? (chapterPhotos.Count > 0 ? chapterPhotos[^1] : start);
        return start == end ? start.ToString("d MMM yyyy") : $"{start:d MMM yyyy} – {end:d MMM yyyy}";
    }

    private static string GetChapterModeLabel(AlbumChapterMode mode) =>
        mode == AlbumChapterMode.ChapterWithPages ? "Page layouts" : "Photo list";

    private async Task EnableChapterPagesAsync()
    {
        if (album is null || selectedChapter is null)
            return;

        var chapter = selectedChapter;
        isEnablingChapterPages = true;
        errorMessage = null;
        statusMessage = null;
        try
        {
            chapter.Mode = AlbumChapterMode.ChapterWithPages;
            if (!await Catalog.UpdateAsync(album))
                throw new InvalidOperationException("The album could not be updated.");

            layoutSaved = false;
            statusMessage = "Page layouts enabled for this chapter. Add pages below, then save the layout.";
        }
        catch (Exception exception)
        {
            chapter.Mode = AlbumChapterMode.ChapterOnly;
            Logger.LogError(exception, "Could not enable chapter page layouts. AlbumId: {AlbumId}, ChapterId: {ChapterId}", album.Id, chapter.Id);
            errorMessage = $"Could not enable page layouts: {exception.Message}";
        }
        finally
        {
            isEnablingChapterPages = false;
        }
    }

    private void AssignLegacyPage()
    {
        if (!CanAssignLegacyPage || selectedPage is null || MigrationTargetChapter is not { } targetChapter)
            return;

        var targetPages = ChapterPages.OrderBy(page => page.Number).ToList();
        selectedPage.ChapterId = targetChapter.Id;
        selectedPage.Number = targetPages.Count == 0 ? 1 : targetPages[^1].Number + 1;
        targetPages.Add(selectedPage);
        RenumberPagesFrom(targetPages);
        editingLegacyPages = false;
        selectedChapterId = targetChapter.Id;
        SelectPage(selectedPage.Number);
        layoutSaved = false;
        errorMessage = null;
        statusMessage = "Legacy page assigned to the selected chapter. Save the layout to keep this change.";
    }

    private void AddPage()
    {
        if (selectedChapter is not { Mode: AlbumChapterMode.ChapterWithPages } chapter)
            return;

        var layout = albumLayout!;
        var chapterPages = ChapterPages;
        var nextNumber = chapterPages.Count == 0 ? 1 : chapterPages.Max(page => page.Number) + 1;
        var page = new LayoutPage
        {
            Number = nextNumber,
            ChapterId = chapter.Id,
            TemplateId = LayoutTemplateIds.OneBig,
            Photos = LayoutTemplates.Get(LayoutTemplateIds.OneBig).Slots.ToList(),
        };
        layout.Pages.Add(page);
        SelectPage(nextNumber);
    }

    private void DeletePage(int pageNumber)
    {
        albumLayout!.Pages.RemoveAll(page =>
            (editingLegacyPages ? string.IsNullOrWhiteSpace(page.ChapterId) : page.ChapterId == selectedChapterId)
            && page.Number == pageNumber);
        RenumberPages();
        if (editingLegacyPages && LegacyPages.Count == 0)
            editingLegacyPages = false;
        SelectPage(CurrentEditorPages.Count == 0 ? 0 : CurrentEditorPages.Min(page => page.Number));
    }

    private void MovePage(int pageNumber, int direction)
    {
        var pages = CurrentEditorPages.ToList();
        var index = pages.FindIndex(page => page.Number == pageNumber);
        var targetIndex = index + direction;
        if (index < 0 || targetIndex < 0 || targetIndex >= pages.Count)
            return;

        (pages[index], pages[targetIndex]) = (pages[targetIndex], pages[index]);
        RenumberPagesFrom(pages);
        SelectPage(selectedPageNumber);
    }

    private void RenumberPages()
    {
        RenumberPagesFrom(CurrentEditorPages.OrderBy(page => page.Number).ToList());
    }

    private void RenumberPagesFrom(List<LayoutPage> pages)
    {
        for (var i = 0; i < pages.Count; i++)
            pages[i].Number = i + 1;

    }

    private void OnTemplateSelected(string templateId)
    {
        if (selectedPage is null
            || selectedPage.Photos.Any(slot => !string.IsNullOrWhiteSpace(slot.PhotoId))
            || string.Equals(templateId, selectedPage.TemplateId, StringComparison.OrdinalIgnoreCase))
            return;

        selectedPage.TemplateId = templateId;
        selectedPage.Photos = LayoutTemplates.MigratePhotos(templateId, selectedPage.Photos).ToList();
    }

    private void HandleLibraryDragStart(string photoId)
    {
        draggedPhotoId = photoId;
        draggedFromSlotCol = null;
        draggedFromSlotRow = null;
        draggedFromTitlePage = false;
        draggedFromPageNumber = null;
    }

    private Task HandleDragStarted(LayoutDragStartEventArgs args)
    {
        draggedPhotoId = args.PhotoId;
        draggedFromSlotCol = args.slotCol;
        draggedFromSlotRow = args.slotRow;
        draggedFromTitlePage = args.IsTitlePage;
        draggedFromPageNumber = args.FromPageNumber;
        return Task.CompletedTask;
    }

    private Task HandlePositionChanged(LayoutPositionChangedEventArgs args)
    {
        layoutSaved = false;
        statusMessage = "Photo position changed. Save the layout to persist it.";
        return Task.CompletedTask;
    }

    private Task HandleZoomChanged(LayoutZoomChangedEventArgs args)
    {
        layoutSaved = false;
        statusMessage = "Zoom changed. Save the layout to persist it.";
        return Task.CompletedTask;
    }

    private Task HandleDropped(LayoutDropEventArgs args)
    {
        if (string.IsNullOrWhiteSpace(draggedPhotoId))
            return Task.CompletedTask;

        if (args.IsTitlePage
            && photoLookup.TryGetValue(draggedPhotoId, out var coverPhoto)
            && PhotoType.IsVideo(coverPhoto))
        {
            errorMessage = "Videos can only be placed in a Page L slot.";
            ClearDragState();
            return Task.CompletedTask;
        }

        if (args.IsTitlePage)
        {
            if (draggedFromTitlePage && draggedFromSlotCol == 0 && draggedFromSlotRow == 0)
            {
                ClearDragState();
                return Task.CompletedTask;
            }

            albumLayout!.CoverPhotoId = draggedPhotoId;
           
            if (draggedFromPageNumber is int pageNumber && pageNumber > 0 &&
                draggedFromSlotCol is int sourceCol && draggedFromSlotRow is int sourceRow)
                ClearSlotOnPage(pageNumber, sourceCol, sourceRow);

            ClearDragState();
            return Task.CompletedTask;
        }

        if (selectedPage is null)
        {
            ClearDragState();
            return Task.CompletedTask;
        }

        var targetSlot = selectedPage.Photos.FirstOrDefault(slot =>
            slot.Col == args.slotCol && slot.Row == args.slotRow);
        if (targetSlot is null)
        {
            ClearDragState();
            return Task.CompletedTask;
        }

        if (photoLookup.TryGetValue(draggedPhotoId, out var draggedPhoto)
            && !PhotoType.IsCompatible(targetSlot.Type.Id, draggedPhoto))
        {
            errorMessage = $"This media type or orientation is not compatible with the {targetSlot.Type.Name.ToLowerInvariant()} slot.";
            ClearDragState();
            return Task.CompletedTask;
        }

        if (!editingLegacyPages
            && selectedChapter?.PhotoIds.Contains(draggedPhotoId, StringComparer.OrdinalIgnoreCase) != true)
        {
            errorMessage = "This photo is not selected for the current chapter.";
            ClearDragState();
            return Task.CompletedTask;
        }

        if (draggedFromTitlePage)
        {
            albumLayout!.CoverPhotoId = null;
            targetSlot.PhotoId = draggedPhotoId;          
            ResetSlotComposition(targetSlot);
            ClearDragState();
            return Task.CompletedTask;
        }

        if (draggedFromPageNumber is int fromPage && fromPage != selectedPage.Number)
        {
            ClearDragState();
            return Task.CompletedTask;
        }

        if (draggedFromSlotCol is null)
        {
            if (!editingLegacyPages)
            {
                AlbumChapterPageRules.RemovePhotoFromIncompatibleChapterPages(
                    albumLayout!.Pages,
                    album!.Chapters,
                    draggedPhotoId);
            }

            targetSlot.PhotoId = draggedPhotoId;            
            ResetSlotComposition(targetSlot);
        }
        else if (draggedFromSlotCol == args.slotCol && draggedFromSlotRow == args.slotRow)
        {
            ClearDragState();
            return Task.CompletedTask;
        }
        else
        {
            var sourceSlot = selectedPage.Photos.FirstOrDefault(slot =>
                slot.Col == draggedFromSlotCol && slot.Row == draggedFromSlotRow);
            if (sourceSlot is null)
            {
                ClearDragState();
                return Task.CompletedTask;
            }

            if (sourceSlot.PhotoId is not null
                && photoLookup.TryGetValue(sourceSlot.PhotoId, out var sourcePhoto)
                && !PhotoType.IsCompatible(targetSlot.Type.Id, sourcePhoto))
            {
                errorMessage = $"The source media type or orientation is not compatible with the {targetSlot.Type.Name.ToLowerInvariant()} slot.";
                ClearDragState();
                return Task.CompletedTask;
            }

            if (targetSlot.PhotoId is not null
                && photoLookup.TryGetValue(targetSlot.PhotoId, out var targetPhoto)
                && !PhotoType.IsCompatible(sourceSlot.Type.Id, targetPhoto))
            {
                errorMessage = "The photos cannot be swapped because their orientations do not match the slots.";
                ClearDragState();
                return Task.CompletedTask;
            }

            SwapSlotContents(sourceSlot, targetSlot);
        }

        ClearDragState();
        return Task.CompletedTask;
    }

    private Task HandleRemoved(LayoutRemoveEventArgs args)
    {
        if (args.IsTitlePage)
        {
            albumLayout!.CoverPhotoId = null;
            
            return Task.CompletedTask;
        }

        if (selectedPage is null)
            return Task.CompletedTask;

        ClearSlot(selectedPage, args.slotCol, args.slotRow);
        return Task.CompletedTask;
    }

    private void ClearSlot(LayoutPage page, int slotCol, int slotRow)
    {
        var slot = page.Photos.FirstOrDefault(item => item.Col == slotCol && item.Row == slotRow);

        if (slot is not null)
        {           
            slot.PhotoId = null;
        }
    }

    private static void ResetSlotComposition(PhotoSlot slot)
    {
        slot.OffsetX = 0d;
        slot.OffsetY = 0d;
        slot.PositionX = 50d;
        slot.PositionY = 50d;
        slot.Zoom = 1d;
    }

    private static void SwapSlotContents(PhotoSlot sourceSlot, PhotoSlot targetSlot)
    {
        (sourceSlot.PhotoId, targetSlot.PhotoId) = (targetSlot.PhotoId, sourceSlot.PhotoId);
        (sourceSlot.OffsetX, targetSlot.OffsetX) = (targetSlot.OffsetX, sourceSlot.OffsetX);
        (sourceSlot.OffsetY, targetSlot.OffsetY) = (targetSlot.OffsetY, sourceSlot.OffsetY);
        (sourceSlot.PositionX, targetSlot.PositionX) = (targetSlot.PositionX, sourceSlot.PositionX);
        (sourceSlot.PositionY, targetSlot.PositionY) = (targetSlot.PositionY, sourceSlot.PositionY);
        (sourceSlot.Zoom, targetSlot.Zoom) = (targetSlot.Zoom, sourceSlot.Zoom);
    }

    private void ClearSlotOnPage(int pageNumber, int slotCol, int slotRow)
    {
        var page = albumLayout!.Pages.FirstOrDefault(item =>
            (editingLegacyPages ? string.IsNullOrWhiteSpace(item.ChapterId) : item.ChapterId == selectedChapterId)
            && item.Number == pageNumber);
        if (page is not null)
            ClearSlot(page, slotCol, slotRow);
    }

    private void ClearDragState()
    {
        draggedPhotoId = null;
        draggedFromSlotCol = null;
        draggedFromSlotRow = null;
        draggedFromTitlePage = false;
        draggedFromPageNumber = null;
    }

    private async Task SaveAsync()
    {
        if (albumLayout is null || album is null)
            return;

        using var activity = PhotoItTelemetry.ActivitySource.StartActivity("album.layout.save");
        activity?.SetTag("album.id", album.Id);
        isSaving = true;
        errorMessage = null;
        statusMessage = null;
        try
        {
            await Catalog.SaveLayoutAsync(albumLayout);
            layoutSaved = true;
            statusMessage = "Layout saved.";
            Logger.LogInformation("Album layout saved. AlbumId: {AlbumId}", album.Id);
        }
        catch (Exception exception)
        {
            activity?.SetStatus(System.Diagnostics.ActivityStatusCode.Error, "Album layout save failed");
            Logger.LogError(exception, "Album layout save failed. AlbumId: {AlbumId}", album.Id);
            errorMessage = $"Save failed: {exception.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }
}
