@page "/albums/{Id}"
@rendermode InteractiveServer
@using PhotoIt.Data
@using PhotoIt.ServiceDefaults
@inject AlbumCatalog Catalog
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject ILogger<AlbumDetails> Logger
@inject AzurePhotoStorage Storage
@using PhotoIt.Web.Components

<PageTitle>@(album?.Name ?? "Album")</PageTitle>

@if (isLoading)
{
    <div class="d-flex justify-content-center align-items-center py-5" role="status" aria-live="polite">
        <span class="spinner-border text-primary" aria-hidden="true"></span>
        <span class="visually-hidden">Loading album...</span>
    </div>
}
else if (album is null)
{
    <div class="alert alert-warning">
        Album not found.
    </div>
        
    <BackToAlbum />
    
}
else
{
    @if (!string.IsNullOrWhiteSpace(deleteError))
    {
        <div class="alert alert-danger" role="alert">@deleteError</div>
    }

    <div class="album-page-header">

       
        <a href="/Albums"
           class="album-back-link">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
            <span>Back to albums</span>
        </a>

        <h1 class="album-page-title">
            @album.Name
        </h1>

        <div class="album-page-subtitle">
            Travel Album
        </div>

    </div>

    <div class="album-toolbar">

        <a class="toolbar-button primary"
           href="/albums/@album.Id/layout/view">

            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12z" stroke-width="2" />
                <circle cx="12" cy="12" r="3" stroke-width="2" />
            </svg>

            <span>View Album</span>
        </a>

        @if (canEdit)
        {
            <a class="toolbar-button"
               href="/albums/@album.Id/photos/manage">

                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <path d="M4 5h16v14H4z" stroke-width="2" />
                    <circle cx="9" cy="10" r="2" stroke-width="2" />
                    <path d="M21 15l-5-5L5 21" stroke-width="2" />
                </svg>

                <span>Manage Photos</span>
            </a>

            <a class="toolbar-button"
               href="/albums/@album.Id/layout/edit">

                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <path d="M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z"
                          stroke-width="2" />
                </svg>

                <span>
                    @(hasLayout ? "Edit Layout" : "Create Layout")
                </span>
            </a>

            <a class="toolbar-button"
               href="/albums/@album.Id/edit">

                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <path d="M12 20h9" stroke-width="2" />
                    <path d="M16.5 3.5a2.1 2.1 0 013 3L7 19l-4 1 1-4 12.5-12.5z"
                          stroke-width="2" />
                </svg>

                <span>Edit Album</span>
            </a>

            
            <a class="toolbar-button"
               href="/albums/@album.Id/theme">
               
                <div class="toolbar-button-theme">
                @if (album.BackGroundFill.ImagePath is null)
                {
                    <div class="theme-color"
                         style="background-color:@album.BackGroundFill.BackroundColor">
                    </div>
                }
                else
                {
                    <img class="theme-img" src="@album.BackGroundFill.ImagePath" alt="Theme" />
                }
                </div>

                <span>Theme</span>
            </a>


            <a class="toolbar-button"
               href="/travelroute/@album.Id">

                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <path d="M12 21s7-5.5 7-11a7 7 0 10-14 0c0 5.5 7 11 7 11z"
                          stroke-width="2" />
                    <circle cx="12"
                            cy="10"
                            r="2.5"
                            stroke-width="2" />
                </svg>

                <span>Travel Route</span>
            </a>

            <button class="toolbar-button danger"
                    type="button"
                    @onclick="ShowDeleteConfirmation">

                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <path d="M3 6h18" stroke-width="2" />
                    <path d="M8 6V4h8v2" stroke-width="2" />
                    <path d="M19 6l-1 14H6L5 6" stroke-width="2" />
                </svg>

                <span>Delete</span>
            </button>
        }

    </div>

    
    <div class="card album-card border-0 shadow-sm rounded-3 h-100">
        <div class="card-body p-4">

            <!-- Header -->
            <div class="d-flex align-items-start justify-content-between gap-3 mb-3">
                <div class="min-w-0">
                    <h5 class="card-title fw-semibold mb-2">
                        @album.Name
                    </h5>

                    <div class="album-folder-badge">
                        <i class="bi bi-folder2 me-1"></i>
                        @album.ImageFolderName
                    </div>
                </div>

                <span class="badge rounded-pill @(hasLayout
                                    ? "text-bg-success"
                                    : "text-bg-secondary") flex-shrink-0">
                    <i class="bi @(hasLayout
                                        ? "bi-check-circle"
                                        : "bi-layout-text-window-reverse") me-1"></i>
                    @(hasLayout ? "Layout ready" : "No layout")
                </span>
            </div>

            <!-- Description -->
            @if (!string.IsNullOrWhiteSpace(album.FullDescription))
            {
                <p class="album-description text-secondary mb-4">
                    @album.FullDescription
                </p>
            }

            <a class="album-photo-search-link" href="/albums/@album.Id/photos" aria-label="Search photos in @album.Name">
                @if (!string.IsNullOrWhiteSpace(coverPhotoId))
                {
                    <img src="/albums/@album.Id/photos/@coverPhotoId/thumbnail" alt="" />
                }
                else
                {
                    <span class="album-photo-search-no-cover">No cover photo</span>
                }
                <span class="album-photo-search-label">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    Search photos
                </span>
            </a>

            <hr class="album-divider" />

            <!-- Metadata -->
            <div class="row g-3 album-meta">

                <div class="col-12 col-sm-6">
                    <div class="meta-item">
                        <div class="meta-label">
                            <i class="bi bi-calendar-plus me-1"></i>
                            Created
                        </div>
                        <div class="meta-value">
                            @album.CreatedUtc.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6">
                    <div class="meta-item">
                        <div class="meta-label">
                            <i class="bi bi-clock-history me-1"></i>
                            Last updated
                        </div>
                        <div class="meta-value">
                            @album.UpdatedUtc.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </div>
}

@if (showDeleteConfirmation && album is not null)
{
    <div class="album-delete-backdrop" role="presentation" @onclick="CancelDelete">
        <section class="album-delete-dialog" role="dialog" aria-modal="true" aria-labelledby="delete-album-title" @onclick:stopPropagation="true">
            <div class="album-delete-dialog-header">
                <h2 id="delete-album-title">Delete album?</h2>
                <button type="button" class="album-delete-close" aria-label="Cancel deletion" disabled="@isDeletingAlbum" @onclick="CancelDelete">×</button>
            </div>

            <div class="album-delete-summary">
                @if (deleteCoverPhotoId is not null)
                {
                    <img src="/albums/@album.Id/photos/@deleteCoverPhotoId/content" alt="Cover for @album.Name" />
                }
                else
                {
                    <div class="album-delete-no-cover">No cover photo</div>
                }
                <div>
                    <h3>@album.Name</h3>
                    <p>@deletePhotos.Count photo@(deletePhotos.Count == 1 ? "" : "s")</p>
                </div>
            </div>

            <p>This will permanently delete the album and its photos.</p>

            @if (!string.IsNullOrWhiteSpace(deleteError))
            {
                <div class="alert alert-danger" role="alert">@deleteError</div>
            }

            <div class="album-delete-actions">
                <button type="button" class="btn btn-outline-secondary" disabled="@isDeletingAlbum" @onclick="CancelDelete">Cancel</button>
                <button type="button" class="btn btn-danger" disabled="@isDeletingAlbum" @onclick="DeleteAsync">
                    @(isDeletingAlbum ? "Deleting…" : "Delete album")
                </button>
            </div>
        </section>
    </div>
}

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private Album? album;
    private bool isLoading = true;
    private bool hasLayout;
    private string? coverPhotoId;
    private bool canEdit;
    private string? shareUrl;
    private bool shareCopied;
    private string? deleteError;
    private bool showDeleteConfirmation;
    private bool isDeletingAlbum;
    private IReadOnlyList<AlbumPhoto> deletePhotos = [];
    private string? deleteCoverPhotoId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            album = await Catalog.GetAsync(Id);
            if (album is null)
                return;

            var layout = await Catalog.GetLayoutAsync(Id);
            hasLayout = layout is not null;
            coverPhotoId = layout?.CoverPhotoId;

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            canEdit = CurrentUserHelper.GetUserId(authState.User) == album.UserId;
            if (canEdit)
            {
                var shareLinkCreated = string.IsNullOrWhiteSpace(album.ShareSlug) || album.ShareSeed <= 0;
                await Catalog.EnsureShareLinkAsync(album);
                if (shareLinkCreated)
                {
                    PhotoItTelemetry.RecordShareCreated();
                    Logger.LogInformation("Album share link created. AlbumId: {AlbumId}", album.Id);
                }

                shareUrl = $"{Navigation.BaseUri.TrimEnd('/')}/sharedalbum/{album.ShareSlug}/{album.ShareSeed}";
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CopyShareLinkAsync()
    {
        if (string.IsNullOrWhiteSpace(shareUrl))
            return;

        await JS.InvokeVoidAsync("navigator.clipboard.writeText", shareUrl);
        shareCopied = true;
    }

    private async Task ShowDeleteConfirmation()
    {
        if (album is null)
            return;

        deleteError = null;
        try
        {
            deletePhotos = await Catalog.ListPhotosAsync(Id);
            var coverPhotoId = (await Catalog.GetLayoutAsync(Id))?.CoverPhotoId;
            deleteCoverPhotoId = deletePhotos.FirstOrDefault(photo => photo.Id == coverPhotoId)?.Id;
            showDeleteConfirmation = true;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not load album details for deletion confirmation. AlbumId: {AlbumId}", Id);
            deleteError = "The album could not be prepared for deletion. Please try again.";
        }
    }

    private void CancelDelete()
    {
        if (isDeletingAlbum)
            return;

        showDeleteConfirmation = false;
        deleteError = null;
    }

    private async Task DeleteAsync()
    {
        if (album is null || isDeletingAlbum)
            return;

        using var activity = PhotoItTelemetry.ActivitySource.StartActivity("album.delete");
        deleteError = null;
        isDeletingAlbum = true;
        var storageDeletionComplete = false;
        try
        {
            var blobNames = deletePhotos
                .SelectMany(photo => new[] { photo.BlobName, photo.ThumbnailBlobName })
                .Where(blobName => !string.IsNullOrWhiteSpace(blobName))
                .Distinct(StringComparer.Ordinal);

            foreach (var blobName in blobNames)
                await Storage.DeleteAsync(blobName!);

            storageDeletionComplete = true;
            if (await Catalog.DeleteAsync(Id))
            {
                PhotoItTelemetry.RecordAlbumDeleted();
                Logger.LogInformation("Album deleted. AlbumId: {AlbumId}", Id);
                Navigation.NavigateTo("albums");
            }
            else
            {
                Logger.LogWarning("Album deletion failed because the album was not found. AlbumId: {AlbumId}", Id);
                deleteError = "The album files were removed, but the album could not be found in the database.";
            }
        }
        catch (Exception exception)
        {
            activity?.SetStatus(System.Diagnostics.ActivityStatusCode.Error, "Album deletion failed");
            Logger.LogError(exception, "Album deletion failed. AlbumId: {AlbumId}", Id);
            deleteError = storageDeletionComplete
                ? "The album files were removed, but its database records could not be deleted. Please contact support."
                : "Some album files could not be deleted from storage. The album and its database records were not deleted; please try again.";
        }
        finally
        {
            isDeletingAlbum = false;
        }
    }
}
