
@inject NavigationManager Navigation
@if (display())
{
<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">CleanCode</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="albums">
                <span class="bi bi-images" aria-hidden="true"></span> Albums
            </NavLink>
        </div>
       
    </nav>
</div>
}

@code {
    public bool display()
    {
        var path = Navigation.Uri;
        // if path contains more than /albums then return false
        if (path.Contains("/albums/") && !path.EndsWith("/albums"))
        {
            return false;
        }
        return true;
    }

}

