@page "/albums/{Id}/photos/manage"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using PhotoIt.Data
@using PhotoIt.ServiceDefaults
@using PhotoIt.AiOrchestration
@using AiFoundryLocal
@using Microsoft.AspNetCore.Components.Forms
@inject AlbumCatalog Catalog
@inject AzurePhotoStorage Storage
@inject PhotoThumbnailService Thumbnails
@inject PhotoVisionOrchestrator VisionOrchestrator
@inject Phi3VisionModel VisionModel
@inject PhotoIndexQueue IndexQueue
@inject ILogger<AlbumPhotos> Logger
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@using PhotoIt.Web.Components
@using PhotoIt.Web.Components.Navigation

<PageTitle>Photos - @(album?.Name ?? "Album")</PageTitle>

@if (album is null)
{
    <div class="alert alert-warning">Album not found.</div>
    <BackToAlbum />    
}
else
{
    @if (canEdit)
    {
    <div class="mb-4">
        <a class="text-decoration-none" href="albums/@album.Id">&larr; Back to album</a>
        <h1 class="mt-3">Manage album photos</h1>
        <p class="text-muted">@album.Name</p>
        <a class="btn btn-outline-secondary" href="/albums/@album.Id/photos">Search all photos</a>
    </div>

        <ul class="nav nav-tabs mb-4" role="tablist" aria-label="Photo management sections">
            <li class="nav-item" role="presentation">
                <button class="nav-link @(activeTab == "upload" ? "active" : "")"
                        type="button"
                        role="tab"
                        aria-selected="@(activeTab == "upload")"
                        @onclick='() => SetActiveTab("upload")'>Upload</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(activeTab == "chapters" ? "active" : "")"
                        type="button"
                        role="tab"
                        aria-selected="@(activeTab == "chapters")"
                        data-photo-upload-chapter-tab
                        disabled="@isUploading"
                        @onclick='() => SetActiveTab("chapters")'>Chapters</button>
            </li>
        </ul>
        @if (activeTab == "upload")
        {
        <div class="border rounded p-4 mb-4 bg-light">
            <label class="form-label" for="photo-upload">Upload photos and videos</label>
            <div class="photo-upload-dropzone" data-file-dropzone>
                <InputFile id="photo-upload"
                           class="photo-upload-input"
                           data-photo-upload-input
                           data-max-files="@MaxUploadFileCount"
                           OnChange="UploadAsync"
                           multiple
                           accept="image/*,.jpg,.rw2,.mp4"
                           disabled="@isUploading" />
                <div class="photo-upload-prompt" aria-hidden="true">
                    <strong>Drop photos here or click to choose files</strong>
                    <span>Images and MP4 videos are supported; up to 1,000 files per upload.</span>
                </div>
            </div>
            <div class="form-text">Images and MP4 videos are stored in Azure Blob Storage under @album.ImageFolderName. Videos can be placed in Page L slots and play automatically in the album viewer.</div>

            @if (isUploading || uploadTotal > 0)
            {
                <div class="mt-3">
                    <div class="d-flex justify-content-between small text-muted mb-1">
                        <span>@uploadStatus</span>
                        <span>@uploadProgress / @uploadTotal</span>
                    </div>
                    <div class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@UploadPercent">
                        <div class="progress-bar" style="width: @UploadPercent%"></div>
                    </div>
                </div>
            }

            @if (VisionModel.IsLoaded)
            {
                <div class="mt-3 d-flex align-items-center gap-3 flex-wrap">
                    <button class="btn btn-outline-primary" type="button" @onclick="IndexTagsAsync" disabled="@isIndexing">
                        @(isIndexing ? "Indexing tags..." : "Index tags with vision model")
                    </button>
                    @if (!string.IsNullOrWhiteSpace(indexMessage))
                    {
                        <span class="text-muted">@indexMessage</span>
                    }
                </div>
            }
            else
            {
                <p class="mt-3 mb-0 text-muted"><em>Vision model is loading. Photo management is available now.</em></p>
            }

            @if (TaggingItems > 0)
            {
                <div class="mt-3">
                    <div class="d-flex justify-content-between small text-muted mb-1">
                        <span>Background indexing</span>
                        <span>@TaggingComplete / @TaggingItems</span>
                    </div>
                    <div class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@TaggingPercent">
                        <div class="progress-bar" style="width: @TaggingPercent%"></div>
                    </div>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-danger mt-3 mb-0">@errorMessage</div>
            }
        </div>
        }

    @if (canEdit && activeTab == "chapters")
    {
        <section class="card shadow-sm mb-4">
            <div class="card-body">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
                    <div>
                        <h2 class="h5 mb-1">Chapters</h2>
                        <p class="text-muted mb-0">Group photos into days or custom story chapters for the album cover.</p>
                    </div>
                    <div class="d-flex flex-wrap align-items-center gap-3">
                        <div class="form-check">
                            <input id="chapter-title-mode" class="form-check-input" type="checkbox"
                                   checked="@album.UseChapterTitles" @onchange="SetChapterTitleModeAsync" />
                            <label class="form-check-label" for="chapter-title-mode">Show chapter titles instead of dates</label>
                        </div>
                        <button type="button" class="btn btn-primary" @onclick="StartNewChapter" disabled="@(photos.Count == 0)">Add chapter</button>
                    </div>
                </div>

                @if (photos.Count == 0)
                {
                    <p class="text-muted mb-0">Upload photos in the Upload tab before adding a chapter.</p>
                }

                @if (album.Chapters.Count > 0)
                {
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        @foreach (var chapter in album.Chapters)
                        {
                            <div class="border rounded bg-white px-3 py-2 d-flex align-items-center gap-2">
                                <span>@(string.IsNullOrWhiteSpace(chapter.Title) ? FormatChapterDate(chapter.StartDate) : chapter.Title)</span>
                                <small class="text-muted">@GetChapterDayCount(chapter) day@(GetChapterDayCount(chapter) == 1 ? "" : "s")</small>
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => EditChapter(chapter)">Edit</button>
                                <button type="button" class="btn btn-sm btn-outline-danger" aria-label="Delete chapter" @onclick="() => DeleteChapterAsync(chapter.Id)">×</button>
                            </div>
                        }
                    </div>
                }

                @if (isChapterEditorOpen)
                {
                <div class="border rounded p-3 bg-white">
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                        <div>
                            @if (editingChapterId is not null)
                            {
                                <span class="small text-uppercase text-muted">Editing chapter</span>
                            }
                            <h3 class="h4 mb-0">
                                @(editingChapterId is null
                                    ? "Add chapter"
                                    : string.IsNullOrWhiteSpace(chapterTitle) ? "Untitled chapter" : chapterTitle)
                                @if (editingChapterId is not null)
                                {
                                    <span class="fs-6 fw-normal text-muted">(@selectedChapterPhotoIds.Count photo@(selectedChapterPhotoIds.Count == 1 ? "" : "s"))</span>
                                }
                            </h3>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-primary" @onclick="SaveChapterAsync">Save chapter</button>
                            @if (editingChapterId is not null)
                            {
                                <button type="button" class="btn btn-outline-secondary" @onclick="CancelChapterEdit">Cancel</button>
                            }
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label" for="chapter-title">Chapter title</label>
                            <input id="chapter-title" class="form-control" @bind="chapterTitle" @bind:event="oninput" placeholder="e.g. At the coast" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label" for="chapter-date">Start date</label>
                            <InputDate id="chapter-date" class="form-control" @bind-Value="chapterStartDate" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label" for="chapter-end-date">End date (optional)</label>
                            <InputDate id="chapter-end-date" class="form-control" @bind-Value="chapterEndDate" />
                            <div class="form-text">When blank, photos are filtered to the start date, or through the day before the next chapter starts.</div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <span class="form-label d-block">Photos in this chapter (@ChapterPickerPhotos.Count())</span>
                        <div class="chapter-photo-picker">
                            @foreach (var photo in ChapterPickerPhotos.OrderBy(photo => GetPhotoSortDate(photo)))
                            {
                                var isSelected = selectedChapterPhotoIds.Contains(photo.Id);
                                var isVideo = PhotoType.IsVideo(photo);
                                <article class="chapter-photo-choice @(isSelected ? "selected" : "")">
                                    <label class="chapter-photo-select">
                                        <input type="checkbox"
                                               checked="@isSelected"
                                               @onchange="args => SetChapterPhotoSelected(photo.Id, args)" />
                                        <span>Select</span>
                                    </label>
                                    @if (isVideo)
                                    {
                                        <div class="chapter-photo-preview chapter-video-preview" aria-label="Video">
                                            <span aria-hidden="true">▶</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <img class="chapter-photo-preview"
                                             src="@($"/albums/{album.Id}/photos/{photo.Id}/thumbnail")"
                                             alt="@photo.OriginalFileName"
                                             loading="lazy" />
                                    }
                                    @if (isSelected)
                                    {
                                        <span class="chapter-photo-filename" title="@photo.OriginalFileName">@photo.OriginalFileName</span>
                                    }
                                    @if (isSelected && !isVideo)
                                    {
                                        <label class="chapter-thumbnail-select">
                                            <input type="radio"
                                                   name="chapter-thumbnail"
                                                   checked="@(chapterThumbnailPhotoId == photo.Id)"
                                                   @onchange="() => SetChapterThumbnail(photo.Id)" />
                                            <span>Use as chapter cover</span>
                                        </label>
                                    }
                                </article>
                            }
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(chapterError))
                    {
                        <div class="alert alert-danger mt-3 mb-0" role="alert">@chapterError</div>
                    }
                </div>
                }
            </div>
        </section>
    }
        }
        else
        {
            <div class="alert alert-warning">Only the album owner can manage photos and chapters.</div>
            <a href="/albums/@album.Id/photos">Search album photos</a>
        }
    }
}

@code {
    private const int MaxUploadFileCount = 1000;

    [Parameter]
    public string Id { get; set; } = string.Empty;

    private Album? album;
    private IReadOnlyList<AlbumPhoto> photos = [];
    private string activeTab = "upload";
    private bool isUploading;
    private bool isIndexing;
    private bool exifRefreshStarted;
    private bool canEdit;
    private string? errorMessage;
    private string? chapterError;
    private string? indexMessage;
    private string chapterTitle = string.Empty;
    private DateTime? chapterStartDate;
    private DateTime? chapterEndDate;
    private string? chapterThumbnailPhotoId;
    private string? editingChapterId;
    private bool isChapterEditorOpen;
    private readonly HashSet<string> selectedChapterPhotoIds = new(StringComparer.OrdinalIgnoreCase);
    private int uploadProgress;
    private int uploadTotal;
    private string uploadStatus = "Ready";
    private readonly CancellationTokenSource pageCts = new();
    private IEnumerable<AlbumPhoto> ChapterPickerPhotos
    {
        get
        {
            if (chapterStartDate is not DateTime startDate)
                return photos;

            var start = startDate.Date;
            var nextChapterStart = album?.Chapters
                .Where(chapter => chapter.Id != editingChapterId
                    && chapter.StartDate.HasValue
                    && chapter.StartDate.Value.Date > start)
                .Select(chapter => (DateTime?)chapter.StartDate!.Value.Date)
                .OrderBy(date => date)
                .FirstOrDefault();
            var explicitEndExclusive = chapterEndDate?.Date.AddDays(1);
            var endExclusive = explicitEndExclusive.HasValue && nextChapterStart.HasValue
                ? (explicitEndExclusive.Value < nextChapterStart.Value ? explicitEndExclusive.Value : nextChapterStart.Value)
                : explicitEndExclusive ?? nextChapterStart ?? start.AddDays(1);

            if (endExclusive <= start)
                return [];

            return photos.Where(photo =>
            {
                var photoDate = GetPhotoGroupDate(photo);
                return photoDate >= start && photoDate < endExclusive;
            });
        }
    }

    private static DateTime GetPhotoGroupDate(AlbumPhoto photo)
    {
        return AlbumCatalog.GetDisplayDate(photo.DateTakenUtc, photo.UploadedUtc).Date;
    }

    private static DateTime GetPhotoSortDate(AlbumPhoto photo)
    {
        return AlbumCatalog.GetDisplayDate(photo.DateTakenUtc, photo.UploadedUtc);
    }
    private int UploadPercent => uploadTotal == 0 ? 0 : (int)((uploadProgress / (double)uploadTotal) * 100);
    private int TaggingItems => photos.Count(photo => !PhotoType.IsVideo(photo));
    private int TaggingComplete => photos.Count(photo => !PhotoType.IsVideo(photo) && (photo.IndexedUtc is not null || photo.Tags.Count > 0));
    private int TaggingPercent => TaggingItems == 0 ? 0 : (int)((TaggingComplete / (double)TaggingItems) * 100);
    protected override async Task OnInitializedAsync()
    {
        album = await Catalog.GetAsync(Id);
        if (album is not null)
        {
            album.Chapters ??= [];
            foreach (var chapter in album.Chapters)
                chapter.PhotoIds ??= [];
        }
        await LoadPhotosAsync();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        canEdit = CurrentUserHelper.GetUserId(authState.User) == album?.UserId;

        _ = RefreshExifMetadataAsync();
        _ = WaitForModelAsync();
    }

    private async Task RefreshExifMetadataAsync()
    {
        if (exifRefreshStarted || album is null)
            return;

        exifRefreshStarted = true;
        var photosToRefresh = photos.Where(photo => !PhotoType.IsVideo(photo) && !HasExtendedExif(photo)).ToList();
        var changed = false;

        foreach (var photo in photosToRefresh)
        {
            try
            {
                var download = await Storage.DownloadAsync(photo.BlobName);
                await using var content = download.Content;
                using var memory = new MemoryStream();
                await content.CopyToAsync(memory);
                var metadata = PhotoMetadataReader.Extract(memory.ToArray());
                if (!HasMetadataValues(metadata))
                    continue;

                ApplyMetadata(photo, metadata);
                await Catalog.UpdatePhotoAsync(photo);
                changed = true;
            }
            catch
            {
            }
        }

        if (changed)
        {
            await LoadPhotosAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task WaitForModelAsync()
    {
        try
        {
            while (!pageCts.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(1), pageCts.Token);
                await LoadPhotosAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (pageCts.IsCancellationRequested)
        {
        }
    }

    private async Task UploadAsync(InputFileChangeEventArgs args)
    {
        if (album is null)
            return;
        if (args.FileCount == 0)
            return;

        if (args.FileCount > MaxUploadFileCount)
        {
            uploadTotal = args.FileCount;
            uploadProgress = 0;
            uploadStatus = "Too many files";
            errorMessage = $"Select no more than {MaxUploadFileCount:N0} files per upload.";
            return;
        }

        if (!isUploading)
        {
            isUploading = true;
            uploadTotal = args.FileCount;
            uploadProgress = 0;
            uploadStatus = "Uploading...";
            errorMessage = null;
        }

        System.Diagnostics.Activity? uploadActivity = null;

        try
        {
            var files = args.GetMultipleFiles(MaxUploadFileCount);
            foreach (var file in files)
            {
                uploadActivity = PhotoItTelemetry.ActivitySource.StartActivity("photo.upload");
                uploadActivity?.SetTag("media.type", Path.GetExtension(file.Name).Equals(".mp4", StringComparison.OrdinalIgnoreCase) ? "video" : "image");
                var extension = Path.GetExtension(file.Name);
                var isVideo = string.Equals(extension, ".mp4", StringComparison.OrdinalIgnoreCase);
                if (file.ContentType.StartsWith("video/", StringComparison.OrdinalIgnoreCase) && !isVideo)
                    throw new InvalidDataException("Only MP4 videos are supported.");

                var blobName = $"{album.ImageFolderName}/{Guid.NewGuid():N}{extension.ToLowerInvariant()}";
                var contentType = isVideo ? "video/mp4" : file.ContentType;
                var metadata = new AlbumPhotoMetadata();
                byte[]? thumbnailBytes = null;
                var thumbnailUnavailable = false;
                if (isVideo)
                {
                    await using var content = file.OpenReadStream(maxAllowedSize: 100 * 1024 * 1024);
                    await Storage.UploadAsync(blobName, content, contentType, CancellationToken.None);
                }
                else
                {
                    await using var content = file.OpenReadStream(maxAllowedSize: 100 * 1024 * 1024);
                    using var memory = new MemoryStream();
                    await content.CopyToAsync(memory);
                    var bytes = memory.ToArray();
                    metadata = PhotoMetadataReader.Extract(bytes);
                    try
                    {
                        thumbnailBytes = Thumbnails.Create(bytes);
                    }
                    catch (ImageMagick.MagickException exception)
                    {
                        thumbnailUnavailable = true;
                        Logger.LogWarning(exception, "Could not create photo thumbnail during upload. AlbumId: {AlbumId}", album.Id);
                    }
                    await Storage.UploadAsync(blobName, new MemoryStream(bytes), contentType, CancellationToken.None);
                }

                var photo = new AlbumPhoto
                {
                    AlbumId = album.Id,
                    BlobName = blobName,
                    ThumbnailUnavailable = thumbnailUnavailable,
                    OriginalFileName = file.Name,
                    ContentType = contentType,
                    Length = file.Size,
                    PixelWidth = metadata.PixelWidth,
                    PixelHeight = metadata.PixelHeight,
                    UploadedUtc = DateTime.UtcNow,
                    DateTakenUtc = metadata.DateTakenUtc,
                    Latitude = metadata.Latitude,
                    Longitude = metadata.Longitude,
                    CameraMake = metadata.CameraMake,
                    CameraModel = metadata.CameraModel,
                    LensModel = metadata.LensModel,
                    FocalLength = metadata.FocalLength,
                    FocalLength35Mm = metadata.FocalLength35Mm,
                    SubjectDistance = metadata.SubjectDistance,
                    Flash = metadata.Flash,
                    Dimensions = metadata.Dimensions,
                    ExposureTime = metadata.ExposureTime,
                    FNumber = metadata.FNumber,
                    IsoSpeed = metadata.IsoSpeed,
                    ExposureProgram = metadata.ExposureProgram,
                    WhiteBalance = metadata.WhiteBalance,
                };

                if (thumbnailBytes is not null)
                {
                    var thumbnailBlobName = $"{album.ImageFolderName}/thumbnails/{photo.Id}.jpg";
                    await Storage.UploadAsync(
                        thumbnailBlobName,
                        new MemoryStream(thumbnailBytes),
                        "image/jpeg",
                        CancellationToken.None,
                        overwrite: true);
                    photo.ThumbnailBlobName = thumbnailBlobName;
                }

                await Catalog.AddPhotoAsync(photo);
                PhotoItTelemetry.RecordPhotoUploaded();
                Logger.LogInformation("Media uploaded. AlbumId: {AlbumId}, MediaId: {MediaId}", album.Id, photo.Id);
                uploadActivity?.Dispose();
                uploadActivity = null;
                if (!isVideo)
                    IndexQueue.Enqueue(new AlbumPhotoIndexRequest(album.Id, photo.Id));
                uploadProgress++;
                uploadStatus = $"Uploading {uploadProgress} of {uploadTotal}...";
                await InvokeAsync(StateHasChanged);
            }

            await Catalog.TouchAsync(album.Id);
            await LoadPhotosAsync();
            uploadStatus = "Completed";
        }
        catch (Exception exception)
        {
            uploadActivity?.SetStatus(System.Diagnostics.ActivityStatusCode.Error, "Media upload failed");
            uploadActivity?.Dispose();
            PhotoItTelemetry.RecordPhotoUploadFailure();
            Logger.LogError(exception, "Media upload failed. AlbumId: {AlbumId}", album.Id);
            errorMessage = $"Media upload failed: {exception.Message}";
            uploadStatus = "Failed";
        }
        finally
        {
            isUploading = false;
            if (uploadProgress >= uploadTotal)
                uploadProgress = uploadTotal;
            try
            {
                await JS.InvokeVoidAsync("photoUpload.setUploading", false);
            }
            catch (JSDisconnectedException)
            {
            }
            await InvokeAsync(StateHasChanged);
        }
    }

    private void SetActiveTab(string tab)
    {
        if (!isUploading)
            activeTab = tab;
    }

    private async Task IndexTagsAsync()
    {
        if (album is null)
            return;

        isIndexing = true;
        errorMessage = null;
        indexMessage = null;
        try
        {
            var result = await VisionOrchestrator.IndexAlbumPhotosAsync(album.Id, Catalog, Storage);
            await LoadPhotosAsync();
            indexMessage = $"Indexed {result.Indexed}, skipped {result.Skipped}, failed {result.Failed}.";
            if (result.Failed > 0)
                errorMessage = "Some photos could not be indexed. Check the local ONNX model directory and runtime logs.";
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Album photo indexing failed. AlbumId: {AlbumId}", album.Id);
            errorMessage = $"Tag indexing failed. Check the local ONNX model directory and runtime logs: {exception.Message}";
        }
        finally
        {
            isIndexing = false;
        }
    }

    private async Task LoadPhotosAsync()
    {
        photos = album is null ? [] : await Catalog.ListPhotosAsync(album.Id);
    }

    private async Task SetChapterTitleModeAsync(ChangeEventArgs args)
    {
        if (album is null)
            return;

        album.UseChapterTitles = args.Value is bool useTitles && useTitles;
        await Catalog.UpdateAsync(album);
        await InvokeAsync(StateHasChanged);
    }

    private void SetChapterPhotoSelected(string photoId, ChangeEventArgs args)
    {
        if (args.Value is bool selected && selected)
        {
            selectedChapterPhotoIds.Add(photoId);
            chapterThumbnailPhotoId ??= photoId;
        }
        else
        {
            selectedChapterPhotoIds.Remove(photoId);
            if (string.Equals(chapterThumbnailPhotoId, photoId, StringComparison.OrdinalIgnoreCase))
                chapterThumbnailPhotoId = selectedChapterPhotoIds.FirstOrDefault();
        }
    }

    private void SetChapterThumbnail(string photoId)
    {
        chapterThumbnailPhotoId = photoId;
    }

    private void EditChapter(AlbumChapter chapter)
    {
        editingChapterId = chapter.Id;
        isChapterEditorOpen = true;
        chapterTitle = chapter.Title;
        chapterStartDate = chapter.StartDate;
        chapterEndDate = chapter.EndDate;
        selectedChapterPhotoIds.Clear();
        foreach (var photoId in chapter.PhotoIds)
            selectedChapterPhotoIds.Add(photoId);
        chapterThumbnailPhotoId = chapter.ThumbnailPhotoId;
        chapterError = null;
    }

    private void StartNewChapter()
    {
        CancelChapterEdit();
        isChapterEditorOpen = true;
    }

    private async Task SaveChapterAsync()
    {
        if (album is null)
            return;

        if (!selectedChapterPhotoIds.Any(photoId =>
                photos.Any(photo => photo.Id == photoId && !PhotoType.IsVideo(photo))))
        {
            chapterError = "Each chapter needs at least one image to use as its thumbnail.";
            return;
        }

        if (string.IsNullOrWhiteSpace(chapterTitle) && chapterStartDate is null)
        {
            chapterError = "Enter a chapter title or start date.";
            return;
        }

        if (chapterStartDate is DateTime startDate
            && chapterEndDate is DateTime endDate
            && endDate.Date < startDate.Date)
        {
            chapterError = "The chapter end date cannot be before its start date.";
            return;
        }
        if (chapterEndDate.HasValue && !chapterStartDate.HasValue)
        {
            chapterError = "Set a start date before setting an end date.";
            return;
        }

        var chapter = album.Chapters.FirstOrDefault(item => item.Id == editingChapterId)
            ?? new AlbumChapter();
        chapter.Title = chapterTitle.Trim();
        chapter.StartDate = chapterStartDate;
        chapter.EndDate = chapterEndDate;
        chapter.PhotoIds = selectedChapterPhotoIds.ToList();
        chapter.ThumbnailPhotoId = selectedChapterPhotoIds.Contains(chapterThumbnailPhotoId ?? string.Empty)
            && photos.Any(photo => photo.Id == chapterThumbnailPhotoId && !PhotoType.IsVideo(photo))
            ? chapterThumbnailPhotoId
            : selectedChapterPhotoIds.First(photoId => photos.Any(photo => photo.Id == photoId && !PhotoType.IsVideo(photo)));

        foreach (var existing in album.Chapters.Where(item => item.Id != chapter.Id))
            existing.PhotoIds.RemoveAll(photoId => selectedChapterPhotoIds.Contains(photoId));
        album.Chapters.RemoveAll(item => item.Id != chapter.Id && item.PhotoIds.Count == 0);

        if (!album.Chapters.Any(item => item.Id == chapter.Id))
            album.Chapters.Add(chapter);

        await Catalog.UpdateAsync(album);
        CancelChapterEdit();
    }

    private async Task DeleteChapterAsync(string chapterId)
    {
        if (album is null)
            return;

        album.Chapters.RemoveAll(chapter => chapter.Id == chapterId);
        await Catalog.UpdateAsync(album);
        if (editingChapterId == chapterId)
            CancelChapterEdit();
    }

    private void CancelChapterEdit()
    {
        editingChapterId = null;
        isChapterEditorOpen = false;
        chapterTitle = string.Empty;
        chapterStartDate = null;
        chapterEndDate = null;
        chapterThumbnailPhotoId = null;
        selectedChapterPhotoIds.Clear();
        chapterError = null;
    }

    private static string FormatChapterDate(DateTime? date) =>
        date?.ToString("d MMM yyyy") ?? "Untitled chapter";

    private int GetChapterDayCount(AlbumChapter chapter)
    {
        if (chapter.StartDate is DateTime start)
        {
            var nextChapterStart = album?.Chapters
                .Where(candidate => candidate.Id != chapter.Id
                    && candidate.StartDate.HasValue
                    && candidate.StartDate.Value.Date > start.Date)
                .Select(candidate => (DateTime?)candidate.StartDate!.Value.Date)
                .OrderBy(date => date)
                .FirstOrDefault();
            var nextEnd = nextChapterStart?.AddDays(-1);
            var end = chapter.EndDate?.Date is DateTime explicitEnd && nextEnd.HasValue
                ? (explicitEnd < nextEnd.Value ? explicitEnd : nextEnd.Value)
                : chapter.EndDate?.Date ?? nextEnd ?? start.Date;
            return Math.Max(1, (end - start.Date).Days + 1);
        }

        var photoDates = photos
            .Where(photo => chapter.PhotoIds.Contains(photo.Id, StringComparer.OrdinalIgnoreCase))
            .Select(GetPhotoGroupDate)
            .Distinct()
            .Count();
        if (photoDates > 0)
            return photoDates;
        return chapter.EndDate.HasValue ? 1 : 0;
    }

    private static bool HasExtendedExif(AlbumPhoto photo)
    {
        return !string.IsNullOrWhiteSpace(photo.LensModel)
            || !string.IsNullOrWhiteSpace(photo.FocalLength)
            || !string.IsNullOrWhiteSpace(photo.Dimensions)
            || !string.IsNullOrWhiteSpace(photo.ExposureTime)
            || !string.IsNullOrWhiteSpace(photo.FNumber)
            || !string.IsNullOrWhiteSpace(photo.IsoSpeed);
    }

    private static bool HasMetadataValues(AlbumPhotoMetadata metadata)
    {
        return metadata.DateTakenUtc is not null
            || metadata.Latitude is not null
            || metadata.Longitude is not null
            || !string.IsNullOrWhiteSpace(metadata.LensModel)
            || !string.IsNullOrWhiteSpace(metadata.FocalLength)
            || !string.IsNullOrWhiteSpace(metadata.Dimensions);
    }

    private static void ApplyMetadata(AlbumPhoto photo, AlbumPhotoMetadata metadata)
    {
        photo.DateTakenUtc ??= metadata.DateTakenUtc;
        photo.Latitude ??= metadata.Latitude;
        photo.Longitude ??= metadata.Longitude;
        photo.CameraMake ??= metadata.CameraMake;
        photo.CameraModel ??= metadata.CameraModel;
        photo.LensModel ??= metadata.LensModel;
        photo.FocalLength ??= metadata.FocalLength;
        photo.FocalLength35Mm ??= metadata.FocalLength35Mm;
        photo.SubjectDistance ??= metadata.SubjectDistance;
        photo.Flash ??= metadata.Flash;
        photo.Dimensions ??= metadata.Dimensions;
        photo.ExposureTime ??= metadata.ExposureTime;
        photo.FNumber ??= metadata.FNumber;
        photo.IsoSpeed ??= metadata.IsoSpeed;
        photo.ExposureProgram ??= metadata.ExposureProgram;
        photo.WhiteBalance ??= metadata.WhiteBalance;
        photo.PixelWidth ??= metadata.PixelWidth;
        photo.PixelHeight ??= metadata.PixelHeight;
    }

    public ValueTask DisposeAsync()
    {
        pageCts.Cancel();
        pageCts.Dispose();
        return ValueTask.CompletedTask;
    }
}
