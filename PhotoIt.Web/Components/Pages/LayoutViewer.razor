@page "/albums/{Id}/layout/view"
@rendermode InteractiveServer
@using PhotoIt.Web.Components.Layout
@using PhotoIt.Data
@using Markdig
@inject IJSRuntime JS
@inject AlbumCatalog Catalog
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@using PhotoIt.Web.Components

<PageTitle>@(albumLayout?.Title ?? album?.Name ?? "Album")</PageTitle>

@if (isLoading)
{
    <div class="d-flex justify-content-center align-items-center py-5" role="status" aria-live="polite">
        <span class="spinner-border text-primary" aria-hidden="true"></span>
        <span class="visually-hidden">Loading album...</span>
    </div>
}

else if (album is null)
{
    <div class="alert alert-warning">Album not found.</div>
    <a href="albums">Back to albums</a>
}
else
{
    <main class="magazine-viewer" tabindex="0" @onkeydown="HandleKeyDown">
        <header class="magazine-toolbar">
            @if (!SharedLink)
            {
                <a class="magazine-back-link" href="/albums/@album.Id">← Back to album</a>
            }
            else
            {
                <span class="magazine-brand">PHOTOBOOK</span>
            }
            <div class="magazine-toolbar-actions">
                <button type="button"
                        class="magazine-search-toggle"
                        aria-label="Search album photos"
                        aria-expanded="@isPhotoSearchOpen"
                        @onclick="TogglePhotoSearch">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="10.8" cy="10.8" r="6.8"></circle>
                        <path d="m16 16 5 5"></path>
                    </svg>
                    <span>Search</span>
                </button>
                @if (canEdit && !SharedLink)
                {
                    <a class="magazine-edit-link" href="/albums/@album.Id/layout/edit">Edit layout</a>
                    <a class="magazine-edit-link" href="/albums/@album.Id/edit">Album settings</a>
                }
            </div>
        </header>

        <div class="magazine-layout">
            @if (chapters.Count > 0)
            {
                <aside class="magazine-chapter-sidebar">
                    <p class="magazine-sidebar-heading">Chapters</p>
                    <nav aria-label="Album chapters">
                        @foreach (var chapter in chapters)
                        {
                            <button type="button"
                                    class="magazine-sidebar-chapter @(activeChapterId == chapter.Id ? "active" : "")"
                                    aria-current="@(activeChapterId == chapter.Id ? "page" : null)"
                                    @onclick="() => OpenChapter(chapter.Id)">
                                @if (!string.IsNullOrWhiteSpace(chapter.ThumbnailPhotoId))
                                {
                                    <img class="magazine-sidebar-thumbnail"
                                         src="@GetPhotoThumbnailUrl(chapter.ThumbnailPhotoId)"
                                         alt=""
                                         loading="lazy" />
                                }
                                else
                                {
                                    <span class="magazine-sidebar-thumbnail magazine-sidebar-placeholder" aria-hidden="true">✦</span>
                                }
                                <span class="magazine-sidebar-copy">
                                    @if (!string.IsNullOrWhiteSpace(chapter.DateLabel))
                                    {
                                        <span class="magazine-sidebar-date">@chapter.DateLabel</span>
                                    }
                                    <span class="magazine-sidebar-title">@chapter.Title</span>
                                    <span class="magazine-sidebar-count">@chapter.Photos.Count photo@(chapter.Photos.Count == 1 ? "" : "s")</span>
                                </span>
                            </button>
                        }
                    </nav>
                </aside>
            }
            <div class="magazine-content">
        @if (isPhotoSearchOpen)
        {
            var searchResults = GetPhotoSearchResults();
            <section class="magazine-photo-search" role="search" aria-label="Search album photos">
                <div class="magazine-photo-search-heading">
                    <div>
                        <p class="magazine-eyebrow">Search the album</p>
                        <h1>All photos</h1>
                    </div>
                    <button type="button" class="magazine-text-button" @onclick="ClosePhotoSearch">Back to album</button>
                </div>
                <label class="magazine-search-field">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="10.8" cy="10.8" r="6.8"></circle>
                        <path d="m16 16 5 5"></path>
                    </svg>
                    <input type="search"
                           aria-label="Search filenames, descriptions, tags, and photo details"
                           placeholder="Search filenames, descriptions, tags..."
                           @bind="photoSearchQuery"
                           @bind:event="oninput" />
                </label>
                @if (string.IsNullOrWhiteSpace(photoSearchQuery))
                {
                    <p class="magazine-search-hint">Search across all @photos.Count photo@(photos.Count == 1 ? "" : "s") and videos by filename, description, tags, camera, or date.</p>
                }
                else if (searchResults.Count == 0)
                {
                    <p class="magazine-search-hint">No photos match “@photoSearchQuery”.</p>
                }
                else
                {
                    <p class="magazine-search-hint">@searchResults.Count result@(searchResults.Count == 1 ? "" : "s")</p>
                    <div class="magazine-search-results">
                        @foreach (var photo in searchResults)
                        {
                            <button type="button" class="magazine-search-result" @onclick="() => OpenSearchResult(photo.Id)">
                                @if (PhotoType.IsVideo(photo))
                                {
                                    <span class="magazine-search-thumbnail magazine-search-video" aria-hidden="true">▶</span>
                                }
                                else
                                {
                                    <img class="magazine-search-thumbnail"
                                         src="@GetPhotoThumbnailUrl(photo.Id)"
                                         alt=""
                                         loading="lazy" />
                                }
                                <span class="magazine-search-result-copy">
                                    <strong>@photo.OriginalFileName</strong>
                                    <span>@AlbumCatalog.GetDisplayDate(photo).ToString("d MMM yyyy")</span>
                                    @if (photo.Tags.Count > 0)
                                    {
                                        <span>@string.Join(" · ", photo.Tags)</span>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(photo.Description))
                                    {
                                        <span>@photo.Description</span>
                                    }
                                </span>
                            </button>
                        }
                    </div>
                }
            </section>
        }
        else if (activeChapter is not null)
        {
            <section @key="activeChapter.Id" class="chapter-view">
                <button type="button" class="magazine-text-button" @onclick="BackToCover">← Back to cover</button>
                <div class="chapter-view-heading">
                    @if (!string.IsNullOrWhiteSpace(activeChapter.DateLabel))
                    {
                        <p class="magazine-eyebrow">@activeChapter.DateLabel</p>
                    }
                    <h1>@activeChapter.Title</h1>
                    <p>@activeChapter.Days day@(activeChapter.Days == 1 ? "" : "s") · @activeChapter.Photos.Count photo@(activeChapter.Photos.Count == 1 ? "" : "s")</p>
                </div>
                @if (GetChapterMetadataSummary(activeChapter).Count > 0)
                {
                    <dl class="album-metadata-summary chapter-metadata-summary">
                        @foreach (var item in GetChapterMetadataSummary(activeChapter))
                        {
                            <div>
                                <dt>@item.Label</dt>
                                <dd>@item.Value</dd>
                            </div>
                        }
                    </dl>
                }
                @if (activeChapter.Mode == AlbumChapterMode.ChapterWithPages)
                {
                    @if (activeChapter.Pages.Count == 0)
                    {
                        <p class="magazine-empty-chapter">This chapter does not have any pages yet.</p>
                    }
                    else
                    {
                        <div class="chapter-pages">
                            @foreach (var chapterPage in activeChapter.Pages)
                            {
                                <section class="layout-viewer-page">
                                    <LayoutPageRenderer AlbumId="@album.Id"
                                                        TemplateId="@chapterPage.TemplateId"
                                                        PageNumber="@chapterPage.Number"
                                                        Photos="@chapterPage.Photos"
                                                        Appearance="@chapterPage.Appearance"
                                                        PhotoLookup="@photoLookup"
                                                        Editable="false"
                                                        PresentationMode="@SharedLink" />
                                </section>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="chapter-photo-grid">
                        @foreach (var photo in activeChapter.Photos)
                        {
                            <figure class="chapter-photo">
                                @if (PhotoType.IsVideo(photo))
                                {
                                    <video src="@GetPhotoUrl(photo.Id)" controls playsinline preload="metadata"></video>
                                }
                                else
                                {
                                    <img src="@GetPhotoUrl(photo.Id)" alt="Photo from @activeChapter.Title" loading="lazy" />
                                }
                            </figure>
                        }
                    </div>
                }
            </section>
        }
        else if (currentViewIndex == 0)
        {
            <section class="magazine-cover">
                <div class="magazine-hero" style="@GetCoverStyle()">
                    <div class="magazine-hero-copy">
                        <p class="magazine-eyebrow">A collection of moments</p>
                        <h1>@GetCoverTitle()</h1>
                        @if (!string.IsNullOrWhiteSpace(GetCoverSubtitle()))
                        {
                            <p class="magazine-hero-subtitle">@GetCoverSubtitle()</p>
                        }
                    </div>
                    <div class="magazine-hero-meta">
                        <span>@GetCoverPeriod()</span>
                        <span>@photos.Count photo@(photos.Count == 1 ? "" : "s")</span>
                        @if (GetAlbumType().Id == AlbumTypeCatalog.Default.Id
                            && album.ShowRouteOnCover && HasRoute)
                        {
                            <button type="button" class="magazine-hero-route" @onclick="OpenRouteMap">
                                @GetDistanceLabel() · View route
                            </button>
                        }
                    </div>
                </div>

                <div class="magazine-cover-content">
                    <div class="magazine-info-grid">
                        <section class="magazine-info-card magazine-story-card">
                            <div>
                                <p class="magazine-eyebrow">The story</p>
                                <h2>Our story</h2>
                                <p class="magazine-card-copy">@GetIntroductionPreview()</p>
                                <button type="button" class="magazine-dark-button" @onclick="OpenIntroduction">Read more <span aria-hidden="true">→</span></button>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(storyPhotoId))
                            {
                                <img src="@GetPhotoThumbnailUrl(storyPhotoId)" alt="A photo from @album.Name" loading="lazy" />
                            }
                        </section>

                        <section class="magazine-info-card magazine-stats-card">
                            <p class="magazine-eyebrow">@GetAlbumType().Icon @GetAlbumType().Name</p>
                            <h2>@GetAlbumType().Name summary</h2>
                            <div class="magazine-stats">
                                @foreach (var item in GetAlbumSummaryItems())
                                {
                                    <div>
                                        <strong>@item.Value</strong><span>@item.Label</span>
                                    </div>
                                }
                            </div>
                        </section>

                        @if (GetAlbumType().Id == AlbumTypeCatalog.Default.Id
                            && album.ShowRouteOnCover && HasRoute)
                        {
                            <section class="magazine-info-card magazine-route-card">
                                <div class="magazine-route-heading">
                                    <div>
                                        <p class="magazine-eyebrow">The way we went</p>
                                        <h2>Our route</h2>
                                    </div>
                                    <button type="button" class="magazine-text-button" @onclick="OpenRouteMap">View full map →</button>
                                </div>
                                <p class="magazine-route-stops">@GetRouteSummary()</p>
                                <button type="button" class="magazine-route-open" @onclick="OpenRouteMap">Explore route <span aria-hidden="true">↗</span></button>
                            </section>
                        }
                    </div>

                    @if (chapters.Count > 0)
                    {
                        <section class="magazine-chapters">
                            <div class="magazine-section-heading">
                                <div>
                                    <p class="magazine-eyebrow">@GetAlbumType().PresentationHint</p>
                                    <h2>Chapters</h2>
                                </div>
                                <span>@chapters.Count chapters</span>
                            </div>
                            <div class="magazine-chapter-grid">
                                @foreach (var chapter in chapters)
                                {
                                    <button type="button" class="magazine-chapter-card" @onclick="() => OpenChapter(chapter.Id)">
                                        @if (!string.IsNullOrWhiteSpace(chapter.ThumbnailPhotoId))
                                        {
                                            <img src="@GetPhotoThumbnailUrl(chapter.ThumbnailPhotoId)" alt="" loading="lazy" />
                                        }
                                        else
                                        {
                                            <span class="magazine-chapter-placeholder" aria-hidden="true">✦</span>
                                        }
                                        <span class="magazine-chapter-copy">
                                            @if (!string.IsNullOrWhiteSpace(chapter.DateLabel))
                                            {
                                                <span class="magazine-chapter-date">@chapter.DateLabel</span>
                                            }
                                            <strong>@chapter.Title</strong>
                                            <span>@chapter.Days day@(chapter.Days == 1 ? "" : "s") · @chapter.Photos.Count photo@(chapter.Photos.Count == 1 ? "" : "s")</span>
                                        </span>
                                        <span class="magazine-chapter-arrow" aria-hidden="true">→</span>
                                    </button>
                                }
                            </div>
                        </section>
                    }

                    <footer class="magazine-footer-quote">
                        <span aria-hidden="true">✦</span>
                        <p>Every photograph holds a story worth revisiting.</p>
                        <button type="button" class="magazine-dark-button" @onclick="StartAlbum">View album <span aria-hidden="true">→</span></button>
                    </footer>
                </div>
            </section>
        }
        else if (currentViewIndex == 1)
        {
            <article class="magazine-read-more">
                <button type="button" class="magazine-text-button" @onclick="() => currentViewIndex = 0">← Back to cover</button>
                <p class="magazine-eyebrow">The story behind the photographs</p>
                <h1>@album.Name</h1>
                @if (string.IsNullOrWhiteSpace(album.Intro))
                {
                    <p class="magazine-empty-intro">No introduction has been added yet.</p>
                }
                else
                {
                    <div class="magazine-introduction-content">
                        @((MarkupString)Markdown.ToHtml(album.Intro))
                    </div>
                }
            </article>
        }
        else if (currentContentPage is not null)
        {
            <div class="layout-viewer-page">
                <LayoutPageRenderer AlbumId="@album.Id"
                                    TemplateId="@currentContentPage.TemplateId"
                                    Photos="@currentContentPage.Photos"
                                    Appearance="@currentContentPage.Appearance"
                                    PhotoLookup="@photoLookup"
                                    Editable="false"
                                    PresentationMode="@SharedLink" />
            </div>
        }

        @if (routeMapOpen)
        {
            <div class="magazine-map-backdrop" role="presentation" @onclick="CloseRouteMap">
                <section class="magazine-map-dialog" role="dialog" aria-modal="true" aria-labelledby="route-map-title" @onclick:stopPropagation="true">
                    <div class="magazine-map-dialog-header">
                        <div>
                            <p class="magazine-eyebrow">The way we went</p>
                            <h2 id="route-map-title">Our route</h2>
                        </div>
                        <button type="button" class="magazine-map-close" aria-label="Close map" @onclick="CloseRouteMap">×</button>
                    </div>
                    <div id="travelMap" class="magazine-map-canvas"></div>
                    <p class="magazine-map-distance">@GetRouteSummary() <strong>@GetDistanceLabel()</strong></p>
                </section>
            </div>
        }

        @if (searchPreviewPhoto is not null)
        {
            <div class="magazine-photo-preview-backdrop" role="presentation" @onclick="CloseSearchPreview">
                <section class="magazine-photo-preview" role="dialog" aria-modal="true" aria-label="@searchPreviewPhoto.OriginalFileName" @onclick:stopPropagation="true">
                    <div class="magazine-photo-preview-header">
                        <strong>@searchPreviewPhoto.OriginalFileName</strong>
                        <button type="button" class="magazine-map-close" aria-label="Close photo preview" @onclick="CloseSearchPreview">×</button>
                    </div>
                    @if (PhotoType.IsVideo(searchPreviewPhoto))
                    {
                        <video src="@GetPhotoUrl(searchPreviewPhoto.Id)" controls autoplay playsinline preload="metadata"></video>
                    }
                    else
                    {
                        <img src="@GetPhotoUrl(searchPreviewPhoto.Id)" alt="@searchPreviewPhoto.OriginalFileName" />
                    }
                    <div class="magazine-photo-preview-details">
                        <span>@AlbumCatalog.GetDisplayDate(searchPreviewPhoto).ToString("d MMM yyyy")</span>
                        @if (!string.IsNullOrWhiteSpace(searchPreviewPhoto.Description))
                        {
                            <p>@searchPreviewPhoto.Description</p>
                        }
                        @if (searchPreviewPhoto.Tags.Count > 0)
                        {
                            <div class="magazine-photo-preview-tags">
                                @foreach (var tag in searchPreviewPhoto.Tags)
                                {
                                    <span>@tag</span>
                                }
                            </div>
                        }
                    </div>
                </section>
            </div>
        }

        @if (currentViewIndex > 0 && currentViewIndex < totalPages && activeChapter is null)
        {
            <nav class="magazine-page-nav" aria-label="Album pages">
                <button type="button" class="magazine-text-button" @onclick="PreviousPage">← Previous</button>
                <span>@GetPageLabel()</span>
                <button type="button" class="magazine-text-button" @onclick="NextPage" disabled="@(currentViewIndex >= totalPages - 1)">Next →</button>
            </nav>
        }
            </div>
        </div>
    </main>
}

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    [Parameter]
    public bool SharedLink { get; set; }

    private Album? album;
    private bool isLoading = true;
    private ViewableAlbumLayout? albumLayout;
    private Dictionary<string, AlbumPhoto> photoLookup = new(StringComparer.OrdinalIgnoreCase);
    private List<AlbumPhoto> photos = [];
    private List<DisplayChapter> chapters = [];
    private int currentViewIndex;
    private int totalPages;
    private LayoutPage? currentContentPage;
    private bool canEdit;
    private string? activeChapterId;
    private bool isPhotoSearchOpen;
    private string photoSearchQuery = string.Empty;
    private string? searchPreviewPhotoId;
    private bool routeMapOpen;
    private bool routeMapInitialized;
    private DisplayChapter? activeChapter => chapters.FirstOrDefault(chapter => chapter.Id == activeChapterId);
    private AlbumPhoto? searchPreviewPhoto => photos.FirstOrDefault(photo => photo.Id == searchPreviewPhotoId);
    private AlbumTypeDefinition GetAlbumType() => AlbumTypeCatalog.Get(album?.AlbumType);
    private bool HasRoute => GetAlbumType().Id == AlbumTypeCatalog.Default.Id
        && album?.TripGraph?.Legs.Any(leg =>
        leg.From.HasGeoPoint() && leg.To.HasGeoPoint()) == true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            album = await Catalog.GetAsync(Id);
            if (album is null)
                return;

            albumLayout = await Catalog.GetLayoutAsync(Id);

            photos = (await Catalog.ListPhotosAsync(Id)).ToList();
            photoLookup = photos.ToDictionary(photo => photo.Id, StringComparer.OrdinalIgnoreCase);
            album.Chapters ??= [];
            foreach (var chapter in album.Chapters)
            {
                chapter.PhotoIds ??= [];
                chapter.Metadata ??= [];
            }
            album.Metadata ??= [];
            BuildChapters();
            totalPages = 2 + (albumLayout?.Pages.Count(page => string.IsNullOrWhiteSpace(page.ChapterId)) ?? 0);
            UpdateCurrentContentPage();

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            canEdit = CurrentUserHelper.GetUserId(authState.User) == album.UserId;
        }
        finally
        {
            isLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (routeMapOpen && !routeMapInitialized && album is not null)
        {
            await JS.InvokeVoidAsync("travelMap.initialize");
            await JS.InvokeVoidAsync("travelMap.refresh", album.TripGraph);
            routeMapInitialized = true;
        }
        else if (!routeMapOpen)
            routeMapInitialized = false;
    }

    private string GetCoverTitle() =>
        !string.IsNullOrWhiteSpace(albumLayout?.Title) ? albumLayout.Title : album?.Name ?? "Our journey";

    private string GetCoverSubtitle()
    {
        var subtitle = !string.IsNullOrWhiteSpace(albumLayout?.Subtitle)
            ? albumLayout.Subtitle
            : album?.FullDescription;
        if (string.IsNullOrWhiteSpace(subtitle))
            return string.Empty;

        const int maxLength = 180;
        var normalized = string.Join(' ', subtitle.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries));
        return normalized.Length <= maxLength ? normalized : normalized[..(maxLength - 1)].TrimEnd() + "…";
    }

    private string GetCoverStyle()
    {
        var photoId = GetCoverPhotoId();
        return !string.IsNullOrWhiteSpace(photoId)
            ? $"background-image: linear-gradient(180deg, rgba(15, 23, 32, .12) 5%, rgba(15, 23, 32, .12) 35%, rgba(15, 23, 32, .82) 100%), url('/albums/{album!.Id}/photos/{photoId}/thumbnail')"
            : "background-image: linear-gradient(135deg, #637b85, #26343b 70%, #b87d55)";
    }

    private string? GetCoverPhotoId()
    {
        if (!string.IsNullOrWhiteSpace(albumLayout?.CoverPhotoId)
            && photoLookup.TryGetValue(albumLayout.CoverPhotoId, out var selectedCover)
            && !PhotoType.IsVideo(selectedCover))
            return selectedCover.Id;

        return photos
            .Where(photo => !PhotoType.IsVideo(photo))
            .OrderByDescending(photo => photo.PixelWidth.HasValue && photo.PixelHeight.HasValue
                && photo.PixelWidth.Value > photo.PixelHeight.Value)
            .ThenByDescending(photo => photo.PixelWidth.GetValueOrDefault())
            .Select(photo => photo.Id)
            .FirstOrDefault();
    }

    private string? storyPhotoId => GetCoverPhotoId();

    private string GetIntroductionPreview() =>
        !string.IsNullOrWhiteSpace(album?.FullDescription)
            ? album.FullDescription
            : "A collection of moments, places and memories captured along the way.";

    private string GetTravelPeriod()
    {
        var start = album?.TravelStartDate
            ?? photos.Select(photo => (DateTime?)AlbumCatalog.GetDisplayDate(photo)).Min()
            ?? album?.TripGraph?.Legs.Select(leg => leg.StartDate).Where(date => date.HasValue).Min();
        var end = album?.TravelEndDate
            ?? photos.Select(photo => (DateTime?)AlbumCatalog.GetDisplayDate(photo)).Max()
            ?? album?.TripGraph?.Legs.Select(leg => leg.EndDate).Where(date => date.HasValue).Max();

        if (start is null && end is null)
            return "Dates not set";

        var first = start?.ToString("d MMM yyyy");
        var last = end?.ToString("d MMM yyyy");
        return first == last || string.IsNullOrWhiteSpace(last)
            ? first ?? last!
            : $"{first ?? "Start date unknown"} – {last}";
    }

    private string GetCoverPeriod() =>
        GetAlbumType().Id == AlbumTypeCatalog.Default.Id
            ? GetTravelPeriod()
            : GetAlbumType().Description;

    private int GetTravelDayCount()
    {
        if (album?.TravelStartDate is DateTime definedStart
            && album.TravelEndDate is DateTime definedEnd)
        {
            return Math.Max(1, (definedEnd.Date - definedStart.Date).Days + 1);
        }

        var start = album?.TravelStartDate
            ?? photos.Select(photo => (DateTime?)AlbumCatalog.GetDisplayDate(photo)).Min();
        var end = album?.TravelEndDate
            ?? photos.Select(photo => (DateTime?)AlbumCatalog.GetDisplayDate(photo)).Max();
        return start is null || end is null
            ? 0
            : Math.Max(1, (end.Value.Date - start.Value.Date).Days + 1);
    }

    private string GetTravelDayLabel() =>
        GetTravelDayCount() is var dayCount && dayCount > 0 ? dayCount.ToString() : "—";

    private double GetTotalDistanceKm() =>
        album?.TripGraph?.Legs
            .Where(leg => leg.From.HasGeoPoint() && leg.To.HasGeoPoint())
            .Sum(leg => leg.DistanceKm ?? leg.CalculateDistanceKm() ?? 0) ?? 0;

    private string GetDistanceNumber() => GetTotalDistanceKm().ToString("N0");
    private string GetDistanceLabel() => $"{GetDistanceNumber()} km";

    private List<AlbumPhoto> GetPhotoSearchResults()
    {
        var terms = photoSearchQuery
            .Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (terms.Length == 0)
            return [];

        return photos
            .Where(photo =>
            {
                var searchableText = string.Join(' ', new[]
                {
                    photo.OriginalFileName,
                    photo.Description,
                    photo.CameraMake,
                    photo.CameraModel,
                    photo.LensModel,
                    photo.Dimensions,
                    photo.Latitude?.ToString("F6"),
                    photo.Longitude?.ToString("F6"),
                    AlbumCatalog.GetDisplayDate(photo).ToString("d MMM yyyy")
                }.Concat(photo.Tags))
                .ToUpperInvariant();

                return terms.All(term => searchableText.Contains(term, StringComparison.OrdinalIgnoreCase));
            })
            .OrderByDescending(photo => photo.DateTakenUtc ?? photo.UploadedUtc)
            .ToList();
    }

    private void TogglePhotoSearch()
    {
        isPhotoSearchOpen = !isPhotoSearchOpen;
        routeMapOpen = false;
        searchPreviewPhotoId = null;
        if (isPhotoSearchOpen)
            photoSearchQuery = string.Empty;
    }

    private void ClosePhotoSearch()
    {
        isPhotoSearchOpen = false;
        photoSearchQuery = string.Empty;
        searchPreviewPhotoId = null;
    }

    private void OpenSearchResult(string photoId)
    {
        routeMapOpen = false;
        searchPreviewPhotoId = photoId;
    }

    private void CloseSearchPreview() => searchPreviewPhotoId = null;

    private string GetRouteSummary()
    {
        if (!string.IsNullOrWhiteSpace(album?.TripGraph?.RouteDescription))
            return album.TripGraph.RouteDescription.Trim();

        var places = album?.TripGraph?.Legs
            .SelectMany(leg => new[] { leg.From.Place, leg.To.Place })
            .Where(place => !string.IsNullOrWhiteSpace(place))
            .Aggregate(new List<string>(), (result, place) =>
            {
                if (!result.Contains(place, StringComparer.OrdinalIgnoreCase))
                    result.Add(place);
                return result;
            });
        return places is { Count: > 0 } ? string.Join("  ·  ", places) : "Route details";
    }

    private void BuildChapters()
    {
        chapters.Clear();
        if (album is null)
            return;

        var manualIndex = 0;
        foreach (var chapter in album.Chapters.OrderBy(item => item.StartDate).ThenBy(item => item.Title))
        {
            var chapterPhotos = chapter.PhotoIds
                .Where(photoLookup.ContainsKey)
                .Select(photoId => photoLookup[photoId])
                .ToList();
            if (chapterPhotos.Count == 0)
                continue;

            manualIndex++;
            var chapterDate = chapter.StartDate ?? AlbumCatalog.GetDisplayDate(chapterPhotos[0]);
            var title = album.UseChapterTitles && !string.IsNullOrWhiteSpace(chapter.Title)
                ? chapter.Title
                : album.UseChapterTitles ? $"Chapter {manualIndex}" : chapterDate.ToString("d MMM yyyy");
            var dateLabel = chapterDate.ToString("d MMM yyyy");
            var thumbnailId = chapterPhotos.Any(photo =>
                    photo.Id == chapter.ThumbnailPhotoId && !PhotoType.IsVideo(photo))
                ? chapter.ThumbnailPhotoId
                : chapterPhotos.FirstOrDefault(photo => !PhotoType.IsVideo(photo))?.Id;
            chapters.Add(new DisplayChapter(
                chapter.Id,
                title,
                string.Equals(title.Trim(), dateLabel, StringComparison.OrdinalIgnoreCase) ? null : dateLabel,
                thumbnailId,
                chapterPhotos,
                GetChapterDayCount(chapter, chapterPhotos),
                chapter.Mode,
                albumLayout?.Pages
                    .Where(page => page.ChapterId == chapter.Id)
                    .OrderBy(page => page.Number)
                    .ToList() ?? [],
                chapter.Metadata ?? []));
        }

        if (album.Chapters.Count > 0)
            return;

        var dateGroups = photos
            .GroupBy(photo => AlbumCatalog.GetDisplayDate(photo).Date)
            .OrderBy(group => group.Key)
            .ToList();
        for (var index = 0; index < dateGroups.Count; index++)
        {
            var group = dateGroups[index];
            var dateLabel = group.Key.ToString("d MMM yyyy");
            var title = album.UseChapterTitles ? $"Chapter {manualIndex + index + 1}" : dateLabel;
            var groupPhotos = group.OrderBy(photo => AlbumCatalog.GetDisplayDate(photo)).ToList();
            chapters.Add(new DisplayChapter(
                $"date-{group.Key:yyyyMMdd}",
                title,
                string.Equals(title.Trim(), dateLabel, StringComparison.OrdinalIgnoreCase) ? null : dateLabel,
                groupPhotos.FirstOrDefault(photo => !PhotoType.IsVideo(photo))?.Id,
                groupPhotos,
                1,
                AlbumChapterMode.ChapterOnly,
                [],
                []));
        }
    }

    private List<MetadataSummaryItem> GetAlbumSummaryItems()
    {
        var type = GetAlbumType();
        var result = type.AlbumFields
            .Where(field => field.ShowOnCover)
            .Select(field => (Field: field, Value: AlbumTypeCatalog.GetValue(album?.Metadata, type.Id, field.Id)))
            .Where(item => !string.IsNullOrWhiteSpace(item.Value))
            .Select(item => new MetadataSummaryItem(
                item.Field.Label,
                FormatMetadataValue(item.Field, item.Value!)))
            .ToList();
        result.Add(new MetadataSummaryItem("Photos", photos.Count.ToString(System.Globalization.CultureInfo.InvariantCulture)));
        if (type.Id == AlbumTypeCatalog.Default.Id)
        {
            if (album?.TravelStartDate is DateTime travelStart)
                result.Add(new MetadataSummaryItem("Start date", travelStart.ToString("d MMM yyyy")));
            if (album?.TravelEndDate is DateTime travelEnd)
                result.Add(new MetadataSummaryItem("End date", travelEnd.ToString("d MMM yyyy")));
            result.Add(new MetadataSummaryItem("Travel days", GetTravelDayLabel()));
            if (album?.ShowRouteOnCover == true && HasRoute)
                result.Add(new MetadataSummaryItem("Route distance", $"{GetDistanceNumber()} km"));
        }
        else
        {
            switch (type.Id)
            {
                case "baby-kids":
                case "pet":
                    AddChapterCount(result, "Milestones", "milestone");
                    break;
                case "food-cooking":
                    AddChapterCount(result, "Dishes", "dish");
                    AddChapterCount(result, "Recipes", "recipe");
                    break;
                case "family":
                    AddChapterCount(result, "Events", "event");
                    break;
                case "sports":
                    AddChapterCount(result, "Matches/events", "match");
                    AddChapterCount(result, "Achievements", "achievements");
                    var wins = CountChapterValues("result", value =>
                        value.Contains("win", StringComparison.OrdinalIgnoreCase));
                    if (wins > 0)
                        result.Add(new MetadataSummaryItem("Wins", wins.ToString(System.Globalization.CultureInfo.InvariantCulture)));
                    break;
                case "nature-wildlife":
                    AddDistinctChapterCount(result, "Species observed", "species");
                    var observationDays = chapters.Select(chapter => chapter.DateLabel ?? chapter.Title)
                        .Distinct(StringComparer.OrdinalIgnoreCase)
                        .Count();
                    if (observationDays > 0)
                        result.Add(new MetadataSummaryItem(
                            "Observation days",
                            observationDays.ToString(System.Globalization.CultureInfo.InvariantCulture)));
                    break;
                case "corporate-events":
                    AddChapterCount(result, "Sessions", "session");
                    break;
                case "school-years":
                    AddChapterCount(result, "Activities", "activity");
                    break;
                case "bucket-list":
                    var totalGoals = CountChapterValues("goal", _ => true);
                    if (totalGoals > 0)
                    {
                        var completedGoals = CountChapterValues("completion-status", value =>
                            value.Contains("complete", StringComparison.OrdinalIgnoreCase));
                        result.Add(new MetadataSummaryItem(
                            "Completed goals",
                            $"{completedGoals.ToString(System.Globalization.CultureInfo.InvariantCulture)} / {totalGoals.ToString(System.Globalization.CultureInfo.InvariantCulture)}"));
                    }
                    break;
                case "home-renovation":
                    AddDistinctChapterCount(result, "Rooms renovated", "room");
                    var totalCost = CountChapterValues("cost", _ => true, value =>
                        int.TryParse(value, System.Globalization.NumberStyles.Integer,
                            System.Globalization.CultureInfo.InvariantCulture, out var cost) ? cost : 0);
                    if (totalCost > 0)
                    {
                        var currency = AlbumTypeCatalog.GetValue(album?.Metadata, type.Id, "currency");
                        result.Add(new MetadataSummaryItem(
                            "Actual cost",
                            $"{totalCost.ToString("N0", System.Globalization.CultureInfo.CurrentCulture)}{(string.IsNullOrWhiteSpace(currency) ? string.Empty : $" {currency}")}"));
                    }
                    break;
                case "recipe-food-journal":
                    AddChapterCount(result, "Recipes", "recipe");
                    var attempts = CountChapterValues("attempts", _ => true, value =>
                        int.TryParse(value, System.Globalization.NumberStyles.Integer,
                            System.Globalization.CultureInfo.InvariantCulture, out var count) ? count : 0);
                    if (attempts > 0)
                        result.Add(new MetadataSummaryItem(
                            "Cooking attempts",
                            attempts.ToString(System.Globalization.CultureInfo.InvariantCulture)));
                    break;
            }
        }

        return result;
    }

    private int CountChapterValues(string fieldId, Func<string, bool> predicate, Func<string, int>? valueSelector = null)
    {
        var typeId = GetAlbumType().Id;
        var values = chapters
            .Select(chapter => AlbumTypeCatalog.GetValue(chapter.Metadata, typeId, fieldId))
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Select(value => value!)
            .Where(predicate);
        return valueSelector is null ? values.Count() : values.Sum(valueSelector);
    }

    private void AddChapterCount(List<MetadataSummaryItem> result, string label, string fieldId)
    {
        var count = CountChapterValues(fieldId, _ => true);
        if (count == 0)
            return;

        result.Add(new MetadataSummaryItem(
            label,
            count.ToString(System.Globalization.CultureInfo.InvariantCulture)));
    }

    private void AddDistinctChapterCount(List<MetadataSummaryItem> result, string label, string fieldId)
    {
        var typeId = GetAlbumType().Id;
        var count = chapters
            .Select(chapter => AlbumTypeCatalog.GetValue(chapter.Metadata, typeId, fieldId))
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Count();
        if (count == 0)
            return;
        result.Add(new MetadataSummaryItem(label, count.ToString(System.Globalization.CultureInfo.InvariantCulture)));
    }

    private List<MetadataSummaryItem> GetChapterMetadataSummary(DisplayChapter chapter)
    {
        var type = GetAlbumType();
        return type.ChapterFields
            .Select(field => (Field: field, Value: AlbumTypeCatalog.GetValue(chapter.Metadata, type.Id, field.Id)))
            .Where(item => !string.IsNullOrWhiteSpace(item.Value))
            .Select(item => new MetadataSummaryItem(
                item.Field.Label,
                FormatMetadataValue(item.Field, item.Value!)))
            .ToList();
    }

    private static string FormatMetadataValue(AlbumMetadataFieldDefinition field, string value)
    {
        var formattedValue = field.ValueType == AlbumMetadataValueType.Date
            && DateOnly.TryParseExact(value, "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.None, out var date)
                ? date.ToString("d MMM yyyy", System.Globalization.CultureInfo.CurrentCulture)
                : value;
        return string.IsNullOrWhiteSpace(field.Unit) ? formattedValue : $"{formattedValue} {field.Unit}";
    }

    private int GetChapterDayCount(AlbumChapter chapter, IReadOnlyList<AlbumPhoto> chapterPhotos)
    {
        if (chapter.StartDate is DateTime start)
        {
            var nextChapterStart = album?.Chapters
                .Where(candidate => candidate.Id != chapter.Id
                    && candidate.StartDate.HasValue
                    && candidate.StartDate.Value.Date > start.Date)
                .Select(candidate => (DateTime?)candidate.StartDate!.Value.Date)
                .OrderBy(date => date)
                .FirstOrDefault();
            var nextEnd = nextChapterStart?.AddDays(-1);
            var end = chapter.EndDate?.Date is DateTime explicitEnd && nextEnd.HasValue
                ? (explicitEnd < nextEnd.Value ? explicitEnd : nextEnd.Value)
                : chapter.EndDate?.Date ?? nextEnd ?? start.Date;
            return Math.Max(1, (end - start.Date).Days + 1);
        }

        return Math.Max(1, chapterPhotos
            .Select(photo => AlbumCatalog.GetDisplayDate(photo).Date)
            .Distinct()
            .Count());
    }

    private void OpenChapter(string chapterId)
    {
        activeChapterId = chapterId;
        routeMapOpen = false;
    }

    private void BackToCover()
    {
        activeChapterId = null;
        currentViewIndex = 0;
        UpdateCurrentContentPage();
    }

    private void OpenIntroduction() => currentViewIndex = 1;
    private void OpenRouteMap()
    {
        isPhotoSearchOpen = false;
        searchPreviewPhotoId = null;
        routeMapOpen = HasRoute;
    }
    private void CloseRouteMap() => routeMapOpen = false;

    private void StartAlbum()
    {
        if (albumLayout?.Pages.Any(page => string.IsNullOrWhiteSpace(page.ChapterId)) == true)
            currentViewIndex = 2;
        else if (chapters.Count > 0)
            activeChapterId = chapters[0].Id;
        else
            currentViewIndex = 1;
        UpdateCurrentContentPage();
    }

    private void HandleKeyDown(KeyboardEventArgs args)
    {
        if (routeMapOpen || activeChapter is not null || isPhotoSearchOpen || searchPreviewPhoto is not null)
            return;

        if (args.Key is "ArrowLeft" or "ArrowUp")
            PreviousPage();
        else if (args.Key is "ArrowRight" or "ArrowDown")
            NextPage();
    }

    private void UpdateCurrentContentPage()
    {
        if (albumLayout is null || currentViewIndex < 2)
        {
            currentContentPage = null;
            return;
        }

        currentContentPage = albumLayout.Pages
            .Where(page => string.IsNullOrWhiteSpace(page.ChapterId))
            .OrderBy(page => page.Number)
            .ElementAtOrDefault(currentViewIndex - 2);
    }

    private void PreviousPage()
    {
        if (currentViewIndex > 0)
        {
            currentViewIndex--;
            UpdateCurrentContentPage();
        }
    }

    private void NextPage()
    {
        if (currentViewIndex < totalPages - 1)
        {
            currentViewIndex++;
            UpdateCurrentContentPage();
        }
    }

    private string GetPageLabel()
    {
        if (currentViewIndex == 1)
            return "The story";

        return $"Page {currentViewIndex - 1} of {Math.Max(0, totalPages - 2)}";
    }

    private string GetPhotoUrl(string photoId) => $"/albums/{album!.Id}/photos/{photoId}/content";
    private string GetPhotoThumbnailUrl(string photoId) => $"/albums/{album!.Id}/photos/{photoId}/thumbnail";

    private sealed record DisplayChapter(
        string Id,
        string Title,
        string? DateLabel,
        string? ThumbnailPhotoId,
        List<AlbumPhoto> Photos,
        int Days,
        AlbumChapterMode Mode,
        List<LayoutPage> Pages,
        List<AlbumMetadataValue> Metadata);

    private sealed record MetadataSummaryItem(string Label, string Value);
}
